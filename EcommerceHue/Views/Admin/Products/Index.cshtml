@model IEnumerable<EcommerceHue.Models.Product>
@{
    ViewData["Title"] = "Điều Phối Tồn Kho Đặc Sản Huế";
    var productList = Model?.ToList() ?? new List<EcommerceHue.Models.Product>();
    var totalProducts = productList.Count;
    var outOfStock = productList.Count(p => p.StockQuantity == 0);
    var lowStock = productList.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 10);
    var totalStock = productList.Sum(p => p.StockQuantity);
    var categories = ViewBag.Categories as IEnumerable<EcommerceHue.Models.Category> ?? new List<EcommerceHue.Models.Category>();
}

<!-- 1. NHÚNG TRỰC TIẾP BOOTSTRAP 5 VÀ ICON (SELF-CONTAINED UI) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<!-- 2. CẤU TRÚC 4 KHỐI THỐNG KÊ HÀNG NGANG (BOOTSTRAP GRID) -->
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-box-seam me-2"></i>QUẢN LÝ TỒN KHO ĐẶC SẢN HUẾ</h3>
            <p class="text-muted small mb-0">Hệ thống giám sát hạn dùng, điều phối nhập hàng và chống bán vượt mức (Overselling).</p>
        </div>
        <div class="d-flex align-items-center gap-1 flex-wrap">
            <a href="/Admin/Coupons" class="btn btn-outline-purple btn-sm" style="color: #6f42c1; border-color: #6f42c1;"><i class="bi bi-ticket-perforated"></i> Voucher & Email</a>
            <a href="/Admin/Orders" class="btn btn-outline-primary btn-sm"><i class="bi bi-receipt"></i> Đơn hàng</a>
            <a href="/Shipper/Scan" target="_blank" class="btn btn-warning btn-sm fw-bold text-dark"><i class="bi bi-upc-scan"></i> App Shipper</a>
            <button class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#createProductModal"><i class="bi bi-plus-circle"></i> Thêm sản phẩm</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.location.reload();"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
        </div>
    </div>

    <!-- THÔNG BÁO FLASH MESSAGE TỪ SERVER -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-box-seam"></i> Tổng mặt hàng</h6>
                    <h2 class="fw-bold" id="stat-total-products">@totalProducts</h2>
                    <p class="mb-0 text-white-50 small">Đặc sản kinh doanh</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-exclamation-octagon"></i> Hết hàng (Cần nhập)</h6>
                    <h2 class="fw-bold" id="stat-out-of-stock">@outOfStock</h2>
                    <p class="mb-0 text-white-50 small">Số lượng tồn kho = 0</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-bell"></i> Sắp hết hàng (&le; 10)</h6>
                    <h2 class="fw-bold" id="stat-low-stock">@lowStock</h2>
                    <p class="mb-0 text-dark-50 small">Cần chuẩn bị đóng gói</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-graph-up-arrow"></i> Tổng số lượng tồn</h6>
                    <h2 class="fw-bold" id="stat-total-stock">@totalStock</h2>
                    <p class="mb-0 text-white-50 small">Đơn vị: Gói / Hũ / Bình</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-stars me-1"></i> ĐIỀU PHỐI TỒN KHO ĐẶC SẢN HUẾ</span>
            <span class="badge bg-secondary">Cập nhật thời gian thực</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 60px;" class="text-center">ID</th>
                        <th>Đặc Sản & Danh Mục</th>
                        <th style="width: 130px;">Giá Bán</th>
                        <th style="width: 140px;" class="text-center">Hạn Sử Dụng</th>
                        <th style="width: 150px;" class="text-center">Tồn Kho</th>
                        <th style="width: 110px;" class="text-center">Trạng Thái</th>
                        <th style="width: 280px;" class="text-center">Thao Tác Quản Trị</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    @if (!productList.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                                Chưa có sản phẩm nào trong kho.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in productList) {
                            var imgUrl = !string.IsNullOrWhiteSpace(item.ImageUrl) ? item.ImageUrl : "/images/placeholder.jpg";
                        <tr id="row-@item.Id" data-stock="@item.StockQuantity" class="@(!item.IsAvailable ? "table-secondary text-muted" : "")">
                            <td class="text-center fw-bold text-muted">#@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@imgUrl" 
                                         alt="@item.Name" 
                                         class="rounded-3 border object-fit-cover shadow-xs" 
                                         style="width: 48px; height: 48px; flex-shrink: 0;"
                                         onerror="this.src='/images/placeholder.jpg'" />
                                    <div>
                                        <div class="fw-bold text-dark">@(item.Name ?? "Không tên")</div>
                                        <div class="small">
                                            @if (item.Category != null) {
                                                <span class="badge bg-secondary" style="font-size: 0.7rem;">@(item.Category.Name ?? "")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold text-danger">@item.Price.ToString("#,##0") đ</td>
                            <td class="text-center font-monospace small">@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (item.StockQuantity == 0) {
                                    <span class="badge bg-danger fs-6" id="stock-@item.Id">Hết hàng (0)</span>
                                } else if (item.StockQuantity <= 10) {
                                    <span class="badge bg-warning text-dark fs-6" id="stock-@item.Id">Sắp hết (@item.StockQuantity)</span>
                                } else {
                                    <span class="badge bg-success fs-6" id="stock-@item.Id">Còn @item.StockQuantity gói</span>
                                }
                            </td>
                            <td class="text-center" id="status-col-@item.Id">
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Đang bán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
                                        <i class="bi bi-slash-circle me-1"></i>Đã ẩn
                                    </span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="btn-group btn-group-sm shadow-xs" role="group">
                                    <!-- 1. Nút Nhập kho -->
                                    <button class="btn btn-outline-primary btn-restock" 
                                            title="Nhập thêm hàng / Điều chỉnh tồn kho"
                                            data-id="@item.Id" 
                                            data-name="@(item.Name ?? "")" 
                                            data-stock="@item.StockQuantity">
                                        <i class="bi bi-plus-circle"></i> Nhập kho
                                    </button>

                                    <!-- 2. Nút ✏️ Sửa -->
                                    <button class="btn btn-outline-secondary btn-edit-product"
                                            title="Sửa thông tin & Đổi link ảnh"
                                            data-id="@item.Id"
                                            data-name="@(item.Name ?? "")"
                                            data-category-id="@item.CategoryId"
                                            data-price="@((long)item.Price)"
                                            data-stock="@item.StockQuantity"
                                            data-expiry="@item.ExpiryDate.ToString("yyyy-MM-dd")"
                                            data-image="@(item.ImageUrl ?? "")"
                                            data-description="@(item.Description ?? "")"
                                            data-ingredients="@(item.IngredientsOrMaterials ?? "")"
                                            data-packaging="@(item.PackagingSpecs ?? "")"
                                            data-usage="@(item.UsageAndStorage ?? "")"
                                            data-available="@(item.IsAvailable ? "true" : "false")">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>

                                    <!-- 3. Nút 👁️ Đang bán / 🙈 Đã ẩn -->
                                    <button class="btn @(item.IsAvailable ? "btn-outline-success" : "btn-outline-warning") btn-toggle-visibility"
                                            id="btn-vis-@item.Id"
                                            title="@(item.IsAvailable ? "Bấm để ẩn sản phẩm" : "Bấm để mở bán lại")"
                                            data-id="@item.Id"
                                            data-available="@(item.IsAvailable ? "true" : "false")">
                                        @if (item.IsAvailable)
                                        {
                                            <span><i class="bi bi-eye"></i> Đang bán</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-eye-slash"></i> Đã ẩn</span>
                                        }
                                    </button>

                                    <!-- 4. Nút 🗑️ Xóa -->
                                    <button class="btn btn-outline-danger btn-delete-product"
                                            title="Xóa sản phẩm"
                                            data-id="@item.Id"
                                            data-name="@(item.Name ?? "")">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. CỬA SỔ POP-UP BOOTSTRAP MODAL CHÌM (id="restockModal") -->
<div class="modal fade" id="restockModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-arrow-left-right me-1"></i> Điều Chỉnh Tồn Kho Đặc Sản</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><strong>Tên sản phẩm:</strong> <span id="modalProductName" class="text-primary fw-bold"></span></p>
        <p><strong>Tồn kho hiện tại:</strong> <span id="modalProductStock" class="badge bg-secondary"></span></p>
        <input type="hidden" id="modalProductId" />
        
        <div class="mb-3">
          <label class="form-label fw-bold">Số lượng điều chỉnh (Dương: Tăng, Âm: Giảm):</label>
          <input type="number" id="restockQuantity" class="form-control form-control-lg text-center fw-bold border-primary" value="10" placeholder="Ví dụ: 10 hoặc -10" />
          <div class="form-text small text-muted">Nhập số dương để nhập thêm, hoặc số âm để trừ bớt hàng hao hụt / lỗi.</div>
        </div>

        <!-- Hàng nút Tăng -->
        <div class="mb-2">
          <label class="form-label text-muted small fw-semibold">Tăng nhanh số lượng:</label>
          <div class="btn-group w-100 mb-2" role="group">
            <button type="button" class="btn btn-outline-success btn-quick" data-val="1">+1 Gói</button>
            <button type="button" class="btn btn-outline-success btn-quick" data-val="10">+10 Gói</button>
            <button type="button" class="btn btn-outline-success btn-quick" data-val="50">+50 Gói</button>
          </div>
        </div>

        <!-- Hàng nút Giảm mới bổ sung -->
        <div class="mb-3">
          <label class="form-label text-muted small fw-semibold">Giảm nhanh số lượng (Hao hụt / Lỗi):</label>
          <div class="btn-group w-100 mb-3" role="group">
            <button type="button" class="btn btn-outline-danger btn-quick" data-val="-1">-1 Gói</button>
            <button type="button" class="btn btn-outline-danger btn-quick" data-val="-10">-10 Gói</button>
            <button type="button" class="btn btn-outline-danger btn-quick" data-val="-50">-50 Gói</button>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
        <button type="button" class="btn btn-primary fw-bold px-4" id="btnConfirmRestock"><i class="bi bi-check-circle"></i> Xác Nhận Điều Chỉnh</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     MODAL THÊM SẢN PHẨM MỚI (TUÂN THỦ QUY CHUẨN ĐẶC SẢN HUẾ)
     ============================================================ -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content shadow border-0 rounded-4 overflow-hidden">
      <form asp-action="CreateProduct" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-header bg-primary text-white py-3">
          <h5 class="modal-title fw-bold" id="createProductModalLabel">
            <i class="bi bi-plus-circle me-1"></i> Thêm Mới Đặc Sản Huế
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold">Tên đặc sản <span class="text-danger">*</span></label>
              <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Mè xửng Thiên Hương đặc biệt" required />
            </div>
            <div class="col-md-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-semibold mb-0">Danh mục <span class="text-danger">*</span></label>
                <a href="javascript:void(0)" class="small text-primary text-decoration-none btn-toggle-new-cat" data-target="#newCatCreateWrapper" style="font-size: 0.8rem;">
                  <i class="bi bi-plus-circle-dotted"></i> + Thêm mới
                </a>
              </div>
              <select name="CategoryId" class="form-select select-category" required>
                @if (categories != null && categories.Any())
                {
                    foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
                else
                {
                    <option value="1">Mè xửng</option>
                    <option value="2">Tôm chua</option>
                    <option value="3">Trà cung đình Huế</option>
                }
              </select>
              <div class="mt-2" id="newCatCreateWrapper" style="display: none;">
                <div class="input-group input-group-sm">
                  <input type="text" name="newCategoryName" class="form-control" placeholder="Tên danh mục mới..." />
                  <button type="button" class="btn btn-primary btn-save-quick-cat" data-input-target="#newCatCreateWrapper input" data-select-target="#createProductModal .select-category">
                    Lưu & Chọn
                  </button>
                </div>
                <div class="form-text small text-muted" style="font-size: 0.72rem;">Tự động tạo vào CSDL và đồng bộ lên mây</div>
              </div>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" name="Price" class="form-control fw-bold text-danger" placeholder="45000" min="0" step="1000" required />
                <span class="input-group-text">₫</span>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Số lượng tồn kho <span class="text-danger">*</span></label>
              <input type="number" name="StockQuantity" class="form-control fw-bold" placeholder="100" min="0" value="50" required />
              <small class="text-muted">Bắt buộc theo quy chuẩn thực phẩm</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Hạn sử dụng (Expiry Date) <span class="text-danger">*</span></label>
              <input type="date" name="ExpiryDate" class="form-control fw-bold" value="@DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd")" required />
              <small class="text-muted">Bắt buộc cho đặc sản Huế</small>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Đường dẫn hình ảnh (URL)</label>
              <input type="url" name="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Mô tả đặc sản</label>
              <textarea name="Description" class="form-control" rows="3" placeholder="Giới thiệu xuất xứ, hương vị, nét văn hóa cung đình Huế..."></textarea>
            </div>

            <!-- THÔNG TIN BỔ SUNG: NGUYÊN LIỆU/CHẤT LIỆU, QUY CÁCH/THÔNG SỐ, HDSD/BẢO QUẢN -->
            <div class="col-12">
              <hr class="my-2" />
              <h6 class="fw-bold text-primary mb-2" style="font-size: 0.9rem;">
                <i class="bi bi-info-circle me-1"></i> Thông tin bổ sung theo ngành hàng (Tùy chọn - nếu để trống sẽ tự sinh theo danh mục)
              </h6>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Thành phần / Chất liệu</label>
              <textarea name="IngredientsOrMaterials" class="form-control form-control-sm" rows="3" placeholder="Ví dụ thực phẩm: Mạch nha nếp, mè rang...&#10;Hoặc nón lá: Lá nón non phơi sương, vành tre cật..."></textarea>
              <small class="text-muted" style="font-size: 0.72rem;">Thành phần (thực phẩm) hoặc chất liệu cấu tạo (thủ công)</small>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Quy cách / Thông số kỹ thuật</label>
              <textarea name="PackagingSpecs" class="form-control form-control-sm" rows="3" placeholder="Ví dụ thực phẩm: Hộp 450g (22x15x4 cm)...&#10;Hoặc nón lá: Đường kính 41cm, 16 vành tre..."></textarea>
              <small class="text-muted" style="font-size: 0.72rem;">Quy cách đóng gói hoặc kích thước, thông số</small>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">HDSD & Bảo quản</label>
              <textarea name="UsageAndStorage" class="form-control form-control-sm" rows="3" placeholder="Ví dụ thực phẩm: Ăn liền, để ngăn mát...&#10;Hoặc nón lá: Che nắng, treo nơi khô ráo..."></textarea>
              <small class="text-muted" style="font-size: 0.72rem;">Hướng dẫn cách dùng và bảo quản sản phẩm</small>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" id="switchAvailable" checked />
                <label class="form-check-label fw-semibold" for="switchAvailable">Mở bán ngay trên gian hàng</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
            <i class="bi bi-save me-1"></i> Lưu Sản Phẩm Mới
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ============================================================
     MODAL CHỈNH SỬA SẢN PHẨM & CẬP NHẬT ẢNH UNSPLASH
     ============================================================ -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content shadow border-0 rounded-4 overflow-hidden">
      <form id="editProductForm" asp-action="EditProduct" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="editProductId" />
        <div class="modal-header bg-dark text-white py-3">
          <h5 class="modal-title fw-bold" id="editProductModalLabel">
            <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa Đặc Sản Huế
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold">Tên đặc sản <span class="text-danger">*</span></label>
              <input type="text" name="name" id="editProductName" class="form-control" required />
            </div>
            <div class="col-md-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-semibold mb-0">Danh mục <span class="text-danger">*</span></label>
                <a href="javascript:void(0)" class="small text-primary text-decoration-none btn-toggle-new-cat" data-target="#newCatEditWrapper" style="font-size: 0.8rem;">
                  <i class="bi bi-plus-circle-dotted"></i> + Thêm mới
                </a>
              </div>
              <select name="categoryId" id="editProductCategory" class="form-select select-category" required>
                @if (categories != null && categories.Any())
                {
                    foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
                else
                {
                    <option value="1">Mè xửng</option>
                    <option value="2">Tôm chua</option>
                    <option value="3">Trà cung đình Huế</option>
                }
              </select>
              <div class="mt-2" id="newCatEditWrapper" style="display: none;">
                <div class="input-group input-group-sm">
                  <input type="text" name="newCategoryName" class="form-control" placeholder="Tên danh mục mới..." />
                  <button type="button" class="btn btn-primary btn-save-quick-cat" data-input-target="#newCatEditWrapper input" data-select-target="#editProductCategory">
                    Lưu & Chọn
                  </button>
                </div>
                <div class="form-text small text-muted" style="font-size: 0.72rem;">Tự động tạo vào CSDL và đồng bộ lên mây</div>
              </div>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" name="price" id="editProductPrice" class="form-control fw-bold text-danger" min="0" step="1000" required />
                <span class="input-group-text">₫</span>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Số lượng tồn kho <span class="text-danger">*</span></label>
              <input type="number" name="stockQuantity" id="editProductStock" class="form-control fw-bold" min="0" required />
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Hạn sử dụng <span class="text-danger">*</span></label>
              <input type="date" name="expiryDate" id="editProductExpiry" class="form-control fw-bold" required />
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Đường dẫn hình ảnh (URL)</label>
              <div class="input-group">
                <input type="text" name="imageUrl" id="editProductImage" class="form-control" placeholder="https://unsplash.com/photos/..." />
                <button type="button" class="btn btn-outline-secondary" id="btnPreviewImage">Xem trước ảnh</button>
              </div>
              <div class="form-text small text-muted">
                💡 Hỗ trợ dán link Unsplash dạng web <code>https://unsplash.com/photos/...</code>, hệ thống sẽ tự động trích xuất mã ID và chuyển thành link tải trực tiếp.
              </div>
              <div class="mt-2 text-center" id="imagePreviewContainer" style="display: none;">
                <img id="imagePreview" src="" alt="Xem trước" class="rounded-3 border shadow-xs" style="max-height: 140px; max-width: 100%; object-fit: contain;" onerror="this.src='/images/placeholder.jpg'" />
              </div>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Mô tả đặc sản</label>
              <textarea name="description" id="editProductDescription" class="form-control" rows="3"></textarea>
            </div>

            <!-- THÔNG TIN BỔ SUNG: NGUYÊN LIỆU/CHẤT LIỆU, QUY CÁCH/THÔNG SỐ, HDSD/BẢO QUẢN -->
            <div class="col-12">
              <hr class="my-2" />
              <h6 class="fw-bold text-primary mb-2" style="font-size: 0.9rem;">
                <i class="bi bi-info-circle me-1"></i> Thông tin bổ sung theo ngành hàng (Tùy chọn - nếu để trống sẽ tự sinh theo danh mục)
              </h6>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Thành phần / Chất liệu</label>
              <textarea name="ingredientsOrMaterials" id="editProductIngredients" class="form-control form-control-sm" rows="3" placeholder="Ví dụ thực phẩm: Mạch nha nếp, mè rang...&#10;Hoặc nón lá: Lá nón non phơi sương, vành tre cật..."></textarea>
              <small class="text-muted" style="font-size: 0.72rem;">Thành phần (thực phẩm) hoặc chất liệu cấu tạo (thủ công)</small>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Quy cách / Thông số kỹ thuật</label>
              <textarea name="packagingSpecs" id="editProductPackaging" class="form-control form-control-sm" rows="3" placeholder="Ví dụ thực phẩm: Hộp 450g (22x15x4 cm)...&#10;Hoặc nón lá: Đường kính 41cm, 16 vành tre..."></textarea>
              <small class="text-muted" style="font-size: 0.72rem;">Quy cách đóng gói hoặc kích thước, thông số</small>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">HDSD & Bảo quản</label>
              <textarea name="usageAndStorage" id="editProductUsage" class="form-control form-control-sm" rows="3" placeholder="Ví dụ thực phẩm: Ăn liền, để ngăn mát...&#10;Hoặc nón lá: Che nắng, treo nơi khô ráo..."></textarea>
              <small class="text-muted" style="font-size: 0.72rem;">Hướng dẫn cách dùng và bảo quản sản phẩm</small>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="isAvailable" value="true" id="editProductAvailable" />
                <label class="form-check-label fw-semibold" for="editProductAvailable">Mở bán sản phẩm trên gian hàng</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
            <i class="bi bi-save me-1"></i> Lưu Thay Đổi
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 4. JAVASCRIPT AJAX ĐIỀU KHIỂN MỞ POP-UP VÀ LƯU NGẦM -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // =========================================================================
        // 1. POP-UP ĐIỀU CHỈNH TỒN KHO NHANH (QUICK RESTOCK)
        // =========================================================================
        document.querySelectorAll('.btn-restock').forEach(btn => {
            btn.addEventListener('click', function() {
                var currentStock = parseInt(this.dataset.stock) || 0;
                document.getElementById('modalProductId').value = this.dataset.id;
                document.getElementById('modalProductName').innerText = this.dataset.name;
                document.getElementById('modalProductStock').innerText = currentStock + ' gói';
                document.getElementById('modalProductStock').dataset.stock = currentStock;
                document.getElementById('restockQuantity').value = 10;
                var myModal = new bootstrap.Modal(document.getElementById('restockModal'));
                myModal.show();
            });
        });

        document.querySelectorAll('.btn-quick').forEach(btn => {
            btn.addEventListener('click', function() {
                var input = document.getElementById('restockQuantity');
                var currentVal = parseInt(input.value) || 0;
                var delta = parseInt(this.dataset.val) || 0;
                input.value = currentVal + delta;
            });
        });

        document.getElementById('btnConfirmRestock').addEventListener('click', async function() {
            var id = document.getElementById('modalProductId').value;
            var qty = parseInt(document.getElementById('restockQuantity').value) || 0;
            var currentStock = parseInt(document.getElementById('modalProductStock').dataset.stock) || 0;

            if (qty === 0) {
                alert('Vui lòng nhập số lượng điều chỉnh khác 0!');
                return;
            }

            // Kiểm tra an toàn: Số lượng sau khi trừ đi không được phép nhỏ hơn 0 (Tránh lỗi tồn kho bị âm)
            if (currentStock + qty < 0) {
                alert('Số lượng giảm (' + Math.abs(qty) + ' gói) vượt quá tồn kho hiện tại (' + currentStock + ' gói)! Tồn kho không thể âm.');
                document.getElementById('restockQuantity').value = -currentStock;
                return;
            }

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang xử lý...';
            
            try {
                var response = await fetch('/Admin/Products/QuickRestock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'productId=' + encodeURIComponent(id) + '&quantity=' + encodeURIComponent(qty)
                });
                
                var result = await response.json();
                if(result.success) {
                    var newStockVal = result.newStock !== undefined ? result.newStock : result.newStockQuantity;
                    var stockEl = document.getElementById('stock-' + id);
                    if (stockEl) {
                        if (newStockVal === 0) {
                            stockEl.className = 'badge bg-danger fs-6';
                            stockEl.innerText = 'Hết hàng (0)';
                        } else if (newStockVal <= 10) {
                            stockEl.className = 'badge bg-warning text-dark fs-6';
                            stockEl.innerText = 'Sắp hết (' + newStockVal + ')';
                        } else {
                            stockEl.className = 'badge bg-success fs-6';
                            stockEl.innerText = 'Còn ' + newStockVal + ' gói';
                        }
                    }

                    // Cập nhật dataset của nút bấm
                    var triggerBtn = document.querySelector('.btn-restock[data-id="' + id + '"]');
                    if (triggerBtn) {
                        triggerBtn.dataset.stock = newStockVal;
                    }

                    // Cập nhật dataset dòng và tính lại 4 cards thống kê
                    var tr = document.getElementById('row-' + id);
                    if (tr) {
                        tr.setAttribute('data-stock', newStockVal);
                    }
                    updateDashboardCards();

                    bootstrap.Modal.getInstance(document.getElementById('restockModal')).hide();
                    alert((result.message || 'Điều chỉnh tồn kho thành công!') + '\nSố lượng tồn kho mới: ' + newStockVal + ' gói');
                } else {
                    alert('Có lỗi xảy ra: ' + (result.message || 'Không thể thực hiện'));
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi kết nối máy chủ khi điều chỉnh kho!');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle"></i> Xác Nhận Điều Chỉnh';
            }
        });

        // =========================================================================
        // 2. MODAL SỬA SẢN PHẨM & CẬP NHẬT ẢNH (EDIT PRODUCT)
        // =========================================================================
        let editModalInstance = null;
        const editModalEl = document.getElementById('editProductModal');
        if (editModalEl) {
            editModalInstance = new bootstrap.Modal(editModalEl);
        }

        document.querySelectorAll('.btn-edit-product').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                const name = this.dataset.name || '';
                const categoryId = this.dataset.categoryId || '1';
                const price = this.dataset.price || '0';
                const stock = this.dataset.stock || '0';
                const expiry = this.dataset.expiry || '';
                const image = this.dataset.image || '';
                const description = this.dataset.description || '';
                const isAvailable = this.dataset.available === 'true';
                const ingredients = this.dataset.ingredients || '';
                const packaging = this.dataset.packaging || '';
                const usage = this.dataset.usage || '';

                document.getElementById('editProductId').value = id;
                document.getElementById('editProductName').value = name;
                document.getElementById('editProductCategory').value = categoryId;
                document.getElementById('editProductPrice').value = price;
                document.getElementById('editProductStock').value = stock;
                document.getElementById('editProductExpiry').value = expiry;
                document.getElementById('editProductImage').value = image;
                document.getElementById('editProductDescription').value = description;
                document.getElementById('editProductAvailable').checked = isAvailable;

                const elIng = document.getElementById('editProductIngredients');
                if (elIng) elIng.value = ingredients;
                const elPack = document.getElementById('editProductPackaging');
                if (elPack) elPack.value = packaging;
                const elUse = document.getElementById('editProductUsage');
                if (elUse) elUse.value = usage;

                // Cập nhật ảnh preview nếu có
                updateImagePreview(image);

                if (editModalInstance) {
                    editModalInstance.show();
                }
            });
        });

        function updateImagePreview(url) {
            const container = document.getElementById('imagePreviewContainer');
            const img = document.getElementById('imagePreview');
            if (!container || !img) return;

            if (url && url.trim() !== '') {
                // Tự động chuyển đổi hiển thị nếu là link Unsplash web
                let directUrl = url.trim();
                if (directUrl.includes('unsplash.com') && directUrl.includes('/photos/') && !directUrl.includes('/download')) {
                    const clean = directUrl.split('?')[0].replace(/\/$/, '');
                    const afterPhotos = clean.substring(clean.indexOf('/photos/') + 8);
                    const lastDash = afterPhotos.lastIndexOf('-');
                    const id = lastDash >= 0 ? afterPhotos.substring(lastDash + 1) : afterPhotos;
                    if (id) directUrl = `https://unsplash.com/photos/${id}/download?force=true&w=800`;
                }
                img.src = directUrl;
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
                img.src = '';
            }
        }

        const btnPreview = document.getElementById('btnPreviewImage');
        if (btnPreview) {
            btnPreview.addEventListener('click', function() {
                const input = document.getElementById('editProductImage');
                if (input) updateImagePreview(input.value);
            });
        }

        const editImgInput = document.getElementById('editProductImage');
        if (editImgInput) {
            editImgInput.addEventListener('blur', function() {
                updateImagePreview(this.value);
            });
        }

        // =========================================================================
        // 3. CHUYỂN ĐỔI TRẠNG THÁI ẨN / HIỆN (TOGGLE PRODUCT VISIBILITY)
        // =========================================================================
        document.querySelectorAll('.btn-toggle-visibility').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                const currentAvailable = this.dataset.available === 'true';
                const actionLabel = currentAvailable ? 'tạm ẩn' : 'mở bán lại';

                if (!confirm(`Bạn có chắc chắn muốn ${actionLabel} sản phẩm này trên gian hàng?`)) {
                    return;
                }

                const originalHtml = this.innerHTML;
                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

                try {
                    const response = await fetch(`/Admin/Products/ToggleVisibility/${id}`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();
                    if (result.success) {
                        const newAvailable = result.isAvailable;
                        this.dataset.available = newAvailable ? 'true' : 'false';

                        const tr = document.getElementById(`row-${id}`);
                        const statusCol = document.getElementById(`status-col-${id}`);

                        if (newAvailable) {
                            this.className = 'btn btn-outline-success btn-toggle-visibility';
                            this.innerHTML = '<span><i class="bi bi-eye"></i> Đang bán</span>';
                            this.title = 'Bấm để ẩn sản phẩm';
                            if (tr) tr.classList.remove('table-secondary', 'text-muted');
                            if (statusCol) {
                                statusCol.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1"><i class="bi bi-check-circle me-1"></i>Đang bán</span>';
                            }
                        } else {
                            this.className = 'btn btn-outline-warning btn-toggle-visibility';
                            this.innerHTML = '<span><i class="bi bi-eye-slash"></i> Đã ẩn</span>';
                            this.title = 'Bấm để mở bán lại';
                            if (tr) tr.classList.add('table-secondary', 'text-muted');
                            if (statusCol) {
                                statusCol.innerHTML = '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1"><i class="bi bi-slash-circle me-1"></i>Đã ẩn</span>';
                            }
                        }

                        // Cập nhật lại nút edit tương ứng
                        const editBtn = document.querySelector(`.btn-edit-product[data-id="${id}"]`);
                        if (editBtn) {
                            editBtn.dataset.available = newAvailable ? 'true' : 'false';
                        }
                    } else {
                        alert(result.message || 'Không thể chuyển trạng thái sản phẩm!');
                        this.innerHTML = originalHtml;
                    }
                } catch (err) {
                    console.error(err);
                    alert('Lỗi kết nối khi cập nhật trạng thái hiển thị!');
                    this.innerHTML = originalHtml;
                } finally {
                    this.disabled = false;
                }
            });
        });

        // =========================================================================
        // 4. XÓA SẢN PHẨM (DELETE PRODUCT HOẶC TỰ ĐỘNG SOFT-DELETE)
        // =========================================================================
        document.querySelectorAll('.btn-delete-product').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                const name = this.dataset.name || 'sản phẩm này';

                if (!confirm(`⚠️ CẢNH BÁO: Bạn có chắc chắn muốn xóa sản phẩm "${name}"?\n(Nếu sản phẩm đã từng có trong đơn hàng, hệ thống sẽ tự động chuyển sang trạng thái ẨN để bảo toàn lịch sử hóa đơn).`)) {
                    return;
                }

                const originalHtml = this.innerHTML;
                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

                try {
                    const response = await fetch(`/Admin/Products/Delete/${id}`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();
                    if (result.success) {
                        alert(result.message);

                        if (result.isSoftDeleted) {
                            // Chuyển sang hàng ẩn
                            const tr = document.getElementById(`row-${id}`);
                            if (tr) tr.classList.add('table-secondary', 'text-muted');

                            const statusCol = document.getElementById(`status-col-${id}`);
                            if (statusCol) {
                                statusCol.innerHTML = '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1"><i class="bi bi-slash-circle me-1"></i>Đã ẩn</span>';
                            }

                            const visBtn = document.getElementById(`btn-vis-${id}`);
                            if (visBtn) {
                                visBtn.className = 'btn btn-outline-warning btn-toggle-visibility';
                                visBtn.innerHTML = '<span><i class="bi bi-eye-slash"></i> Đã ẩn</span>';
                                visBtn.dataset.available = 'false';
                            }
                        } else {
                            // Xóa hẳn dòng khỏi bảng
                            const tr = document.getElementById(`row-${id}`);
                            if (tr) {
                                tr.remove();
                            }
                            updateDashboardCards();
                        }
                    } else {
                        alert(result.message || 'Không thể xóa sản phẩm!');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Lỗi kết nối khi xóa sản phẩm!');
                } finally {
                    this.disabled = false;
                    this.innerHTML = originalHtml;
                }
            });
        });

        // =========================================================================
        // 5. THÊM NHANH DANH MỤC MỚI CHO SẢN PHẨM (AJAX & LIVE SELECT)
        // =========================================================================
        document.querySelectorAll('.btn-toggle-new-cat').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const targetSelector = this.dataset.target;
                const target = document.querySelector(targetSelector);
                if (target) {
                    const isHidden = target.style.display === 'none' || !target.style.display;
                    target.style.display = isHidden ? 'block' : 'none';
                    if (isHidden) {
                        const input = target.querySelector('input');
                        if (input) input.focus();
                    }
                }
            });
        });

        document.querySelectorAll('.btn-save-quick-cat').forEach(btn => {
            btn.addEventListener('click', async function() {
                const inputEl = document.querySelector(this.dataset.inputTarget);
                const selectEl = document.querySelector(this.dataset.selectTarget);
                if (!inputEl || !inputEl.value.trim()) {
                    alert('Vui lòng nhập tên danh mục mới!');
                    if (inputEl) inputEl.focus();
                    return;
                }

                const catName = inputEl.value.trim();
                const origHtml = this.innerHTML;
                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                try {
                    const res = await fetch('/Admin/Categories/QuickCreate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'name=' + encodeURIComponent(catName)
                    });
                    const data = await res.json();
                    if (data.success && data.category) {
                        // Bổ sung Option mới vào tất cả select danh mục
                        document.querySelectorAll('.select-category').forEach(sel => {
                            let opt = sel.querySelector(`option[value="${data.category.id}"]`);
                            if (!opt) {
                                opt = new Option(data.category.name, data.category.id);
                                sel.add(opt);
                            }
                        });
                        // Chọn danh mục mới tạo
                        if (selectEl) {
                            selectEl.value = data.category.id;
                        }
                        inputEl.value = '';
                        const wrapper = inputEl.closest('[id^="newCat"]');
                        if (wrapper) wrapper.style.display = 'none';
                        alert('✅ ' + data.message);
                    } else {
                        alert(data.message || 'Lỗi khi tạo danh mục!');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Lỗi kết nối khi tạo danh mục mới!');
                } finally {
                    this.disabled = false;
                    this.innerHTML = origHtml;
                }
            });
        });

        // =========================================================================
        // HELPER: CẬP NHẬT 4 CARDS THỐNG KÊ DASHBOARD
        // =========================================================================
        function updateDashboardCards() {
            var rows = document.querySelectorAll('#productTableBody tr[data-stock]');
            var total = rows.length;
            var outOfStock = 0;
            var lowStock = 0;
            var totalStock = 0;

            rows.forEach(r => {
                var s = parseInt(r.getAttribute('data-stock')) || 0;
                totalStock += s;
                if (s === 0) outOfStock++;
                else if (s <= 10) lowStock++;
            });

            var elTotal = document.getElementById('stat-total-products');
            var elOut = document.getElementById('stat-out-of-stock');
            var elLow = document.getElementById('stat-low-stock');
            var elSum = document.getElementById('stat-total-stock');

            if (elTotal) elTotal.innerText = total;
            if (elOut) elOut.innerText = outOfStock;
            if (elLow) elLow.innerText = lowStock;
            if (elSum) elSum.innerText = totalStock;
        }
    });
</script>
