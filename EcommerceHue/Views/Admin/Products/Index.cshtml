@model IEnumerable<EcommerceHue.Models.Product>
@{
    ViewData["Title"] = "Điều Phối Tồn Kho Đặc Sản Huế";
    var productList = Model?.ToList() ?? new List<EcommerceHue.Models.Product>();
    var totalProducts = productList.Count;
    var outOfStock = productList.Count(p => p.StockQuantity == 0);
    var lowStock = productList.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 10);
    var totalStock = productList.Sum(p => p.StockQuantity);
    var categories = ViewBag.Categories as IEnumerable<EcommerceHue.Models.Category> ?? new List<EcommerceHue.Models.Category>();
}

<!-- 1. NHÚNG TRỰC TIẾP BOOTSTRAP 5 VÀ ICON (SELF-CONTAINED UI) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<!-- 2. CẤU TRÚC 4 KHỐI THỐNG KÊ HÀNG NGANG (BOOTSTRAP GRID) -->
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-box-seam me-2"></i>QUẢN LÝ TỒN KHO ĐẶC SẢN HUẾ</h3>
            <p class="text-muted small mb-0">Hệ thống giám sát hạn dùng, điều phối nhập hàng và chống bán vượt mức (Overselling).</p>
        </div>
        <div class="d-flex align-items-center gap-1 flex-wrap">
            <a href="/Admin/Coupons" class="btn btn-outline-purple btn-sm" style="color: #6f42c1; border-color: #6f42c1;"><i class="bi bi-ticket-perforated"></i> Voucher & Email</a>
            <a href="/Admin/Orders" class="btn btn-outline-primary btn-sm"><i class="bi bi-receipt"></i> Đơn hàng</a>
            <a href="/Shipper/Scan" target="_blank" class="btn btn-warning btn-sm fw-bold text-dark"><i class="bi bi-upc-scan"></i> App Shipper</a>
            <button class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#createProductModal"><i class="bi bi-plus-circle"></i> Thêm sản phẩm</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.location.reload();"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
        </div>
    </div>

    <!-- THÔNG BÁO FLASH MESSAGE TỪ SERVER -->
    @if (TempData["AdminSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["AdminSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["AdminError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-box-seam"></i> Tổng mặt hàng</h6>
                    <h2 class="fw-bold" id="stat-total-products">@totalProducts</h2>
                    <p class="mb-0 text-white-50 small">Đặc sản kinh doanh</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-exclamation-octagon"></i> Hết hàng (Cần nhập)</h6>
                    <h2 class="fw-bold" id="stat-out-of-stock">@outOfStock</h2>
                    <p class="mb-0 text-white-50 small">Số lượng tồn kho = 0</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-bell"></i> Sắp hết hàng (&le; 10)</h6>
                    <h2 class="fw-bold" id="stat-low-stock">@lowStock</h2>
                    <p class="mb-0 text-dark-50 small">Cần chuẩn bị đóng gói</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <h6><i class="bi bi-graph-up-arrow"></i> Tổng số lượng tồn</h6>
                    <h2 class="fw-bold" id="stat-total-stock">@totalStock</h2>
                    <p class="mb-0 text-white-50 small">Đơn vị: Gói / Hũ / Bình</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-stars me-1"></i> ĐIỀU PHỐI TỒN KHO ĐẶC SẢN HUẾ</span>
            <span class="badge bg-secondary">Cập nhật thời gian thực</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Tên Đặc Sản & Danh Mục</th>
                        <th style="width: 140px;">Giá Bán</th>
                        <th style="width: 170px;">Hạn Sử Dụng</th>
                        <th style="width: 180px;">Số Lượng Tồn Kho</th>
                        <th style="width: 180px;" class="text-center">Thao Tác Nhập Hàng</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    @if (!productList.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                                Chưa có sản phẩm nào trong kho.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in productList) {
                        <tr id="row-@item.Id" data-stock="@item.StockQuantity">
                            <td>@item.Id</td>
                            <td>
                                <strong>@(item.Name ?? "Không tên")</strong>
                                @if (item.Category != null) {
                                    <span class="badge bg-secondary ms-1">@(item.Category.Name ?? "")</span>
                                }
                            </td>
                            <td>@item.Price.ToString("#,##0") đ</td>
                            <td>@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.StockQuantity == 0) {
                                    <span class="badge bg-danger fs-6" id="stock-@item.Id">Hết hàng (0)</span>
                                } else if (item.StockQuantity <= 10) {
                                    <span class="badge bg-warning text-dark fs-6" id="stock-@item.Id">Sắp hết (@item.StockQuantity)</span>
                                } else {
                                    <span class="badge bg-success fs-6" id="stock-@item.Id">Còn @item.StockQuantity gói</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-outline-primary btn-sm btn-restock" data-id="@item.Id" data-name="@(item.Name ?? "")" data-stock="@item.StockQuantity">
                                    <i class="bi bi-plus-circle"></i> Nhập thêm hàng
                                </button>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. CỬA SỔ POP-UP BOOTSTRAP MODAL CHÌM (id="restockModal") -->
<div class="modal fade" id="restockModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-arrow-left-right me-1"></i> Điều Chỉnh Tồn Kho Đặc Sản</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><strong>Tên sản phẩm:</strong> <span id="modalProductName" class="text-primary fw-bold"></span></p>
        <p><strong>Tồn kho hiện tại:</strong> <span id="modalProductStock" class="badge bg-secondary"></span></p>
        <input type="hidden" id="modalProductId" />
        
        <div class="mb-3">
          <label class="form-label fw-bold">Số lượng điều chỉnh (Dương: Tăng, Âm: Giảm):</label>
          <input type="number" id="restockQuantity" class="form-control form-control-lg text-center fw-bold border-primary" value="10" placeholder="Ví dụ: 10 hoặc -10" />
          <div class="form-text small text-muted">Nhập số dương để nhập thêm, hoặc số âm để trừ bớt hàng hao hụt / lỗi.</div>
        </div>

        <!-- Hàng nút Tăng -->
        <div class="mb-2">
          <label class="form-label text-muted small fw-semibold">Tăng nhanh số lượng:</label>
          <div class="btn-group w-100 mb-2" role="group">
            <button type="button" class="btn btn-outline-success btn-quick" data-val="1">+1 Gói</button>
            <button type="button" class="btn btn-outline-success btn-quick" data-val="10">+10 Gói</button>
            <button type="button" class="btn btn-outline-success btn-quick" data-val="50">+50 Gói</button>
          </div>
        </div>

        <!-- Hàng nút Giảm mới bổ sung -->
        <div class="mb-3">
          <label class="form-label text-muted small fw-semibold">Giảm nhanh số lượng (Hao hụt / Lỗi):</label>
          <div class="btn-group w-100 mb-3" role="group">
            <button type="button" class="btn btn-outline-danger btn-quick" data-val="-1">-1 Gói</button>
            <button type="button" class="btn btn-outline-danger btn-quick" data-val="-10">-10 Gói</button>
            <button type="button" class="btn btn-outline-danger btn-quick" data-val="-50">-50 Gói</button>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
        <button type="button" class="btn btn-primary fw-bold px-4" id="btnConfirmRestock"><i class="bi bi-check-circle"></i> Xác Nhận Điều Chỉnh</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     MODAL THÊM SẢN PHẨM MỚI (TUÂN THỦ QUY CHUẨN ĐẶC SẢN HUẾ)
     ============================================================ -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content shadow border-0 rounded-4 overflow-hidden">
      <form asp-action="CreateProduct" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-header bg-primary text-white py-3">
          <h5 class="modal-title fw-bold" id="createProductModalLabel">
            <i class="bi bi-plus-circle me-1"></i> Thêm Mới Đặc Sản Huế
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold">Tên đặc sản <span class="text-danger">*</span></label>
              <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Mè xửng Thiên Hương đặc biệt" required />
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
              <select name="CategoryId" class="form-select" required>
                @if (categories != null && categories.Any())
                {
                    foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
                else
                {
                    <option value="1">Mè xửng</option>
                    <option value="2">Tôm chua</option>
                    <option value="3">Trà cung đình Huế</option>
                }
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" name="Price" class="form-control fw-bold text-danger" placeholder="45000" min="0" step="1000" required />
                <span class="input-group-text">₫</span>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Số lượng tồn kho <span class="text-danger">*</span></label>
              <input type="number" name="StockQuantity" class="form-control fw-bold" placeholder="100" min="0" value="50" required />
              <small class="text-muted">Bắt buộc theo quy chuẩn thực phẩm</small>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Hạn sử dụng (Expiry Date) <span class="text-danger">*</span></label>
              <input type="date" name="ExpiryDate" class="form-control fw-bold" value="@DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd")" required />
              <small class="text-muted">Bắt buộc cho đặc sản Huế</small>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Đường dẫn hình ảnh (URL)</label>
              <input type="url" name="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold">Mô tả đặc sản</label>
              <textarea name="Description" class="form-control" rows="3" placeholder="Giới thiệu xuất xứ, hương vị, nét văn hóa cung đình Huế..."></textarea>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" id="switchAvailable" checked />
                <label class="form-check-label fw-semibold" for="switchAvailable">Mở bán ngay trên gian hàng</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
            <i class="bi bi-save me-1"></i> Lưu Sản Phẩm Mới
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 4. JAVASCRIPT AJAX ĐIỀU KHIỂN MỞ POP-UP VÀ LƯU NGẦM -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.btn-restock').forEach(btn => {
            btn.addEventListener('click', function() {
                var currentStock = parseInt(this.dataset.stock) || 0;
                document.getElementById('modalProductId').value = this.dataset.id;
                document.getElementById('modalProductName').innerText = this.dataset.name;
                document.getElementById('modalProductStock').innerText = currentStock + ' gói';
                document.getElementById('modalProductStock').dataset.stock = currentStock;
                document.getElementById('restockQuantity').value = 10;
                var myModal = new bootstrap.Modal(document.getElementById('restockModal'));
                myModal.show();
            });
        });

        document.querySelectorAll('.btn-quick').forEach(btn => {
            btn.addEventListener('click', function() {
                var input = document.getElementById('restockQuantity');
                var currentVal = parseInt(input.value) || 0;
                var delta = parseInt(this.dataset.val) || 0;
                input.value = currentVal + delta;
            });
        });

        document.getElementById('btnConfirmRestock').addEventListener('click', async function() {
            var id = document.getElementById('modalProductId').value;
            var qty = parseInt(document.getElementById('restockQuantity').value) || 0;
            var currentStock = parseInt(document.getElementById('modalProductStock').dataset.stock) || 0;

            if (qty === 0) {
                alert('Vui lòng nhập số lượng điều chỉnh khác 0!');
                return;
            }

            // Kiểm tra an toàn: Số lượng sau khi trừ đi không được phép nhỏ hơn 0 (Tránh lỗi tồn kho bị âm)
            if (currentStock + qty < 0) {
                alert('Số lượng giảm (' + Math.abs(qty) + ' gói) vượt quá tồn kho hiện tại (' + currentStock + ' gói)! Tồn kho không thể âm.');
                document.getElementById('restockQuantity').value = -currentStock;
                return;
            }

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang xử lý...';
            
            try {
                var response = await fetch('/Admin/Products/QuickRestock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'productId=' + encodeURIComponent(id) + '&quantity=' + encodeURIComponent(qty)
                });
                
                var result = await response.json();
                if(result.success) {
                    var newStockVal = result.newStock !== undefined ? result.newStock : result.newStockQuantity;
                    var stockEl = document.getElementById('stock-' + id);
                    if (stockEl) {
                        if (newStockVal === 0) {
                            stockEl.className = 'badge bg-danger fs-6';
                            stockEl.innerText = 'Hết hàng (0)';
                        } else if (newStockVal <= 10) {
                            stockEl.className = 'badge bg-warning text-dark fs-6';
                            stockEl.innerText = 'Sắp hết (' + newStockVal + ')';
                        } else {
                            stockEl.className = 'badge bg-success fs-6';
                            stockEl.innerText = 'Còn ' + newStockVal + ' gói';
                        }
                    }

                    // Cập nhật dataset của nút bấm
                    var triggerBtn = document.querySelector('.btn-restock[data-id="' + id + '"]');
                    if (triggerBtn) {
                        triggerBtn.dataset.stock = newStockVal;
                    }

                    // Cập nhật dataset dòng và tính lại 4 cards thống kê
                    var tr = document.getElementById('row-' + id);
                    if (tr) {
                        tr.setAttribute('data-stock', newStockVal);
                    }
                    updateDashboardCards();

                    bootstrap.Modal.getInstance(document.getElementById('restockModal')).hide();
                    alert((result.message || 'Điều chỉnh tồn kho thành công!') + '\nSố lượng tồn kho mới: ' + newStockVal + ' gói');
                } else {
                    alert('Có lỗi xảy ra: ' + (result.message || 'Không thể thực hiện'));
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi kết nối máy chủ khi điều chỉnh kho!');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle"></i> Xác Nhận Điều Chỉnh';
            }
        });

        function updateDashboardCards() {
            var rows = document.querySelectorAll('#productTableBody tr[data-stock]');
            var total = rows.length;
            var outOfStock = 0;
            var lowStock = 0;
            var totalStock = 0;

            rows.forEach(r => {
                var s = parseInt(r.getAttribute('data-stock')) || 0;
                totalStock += s;
                if (s === 0) outOfStock++;
                else if (s <= 10) lowStock++;
            });

            var elTotal = document.getElementById('stat-total-products');
            var elOut = document.getElementById('stat-out-of-stock');
            var elLow = document.getElementById('stat-low-stock');
            var elSum = document.getElementById('stat-total-stock');

            if (elTotal) elTotal.innerText = total;
            if (elOut) elOut.innerText = outOfStock;
            if (elLow) elLow.innerText = lowStock;
            if (elSum) elSum.innerText = totalStock;
        }
    });
</script>
