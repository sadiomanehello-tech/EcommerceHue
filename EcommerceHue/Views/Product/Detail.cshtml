@model EcommerceHue.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} – Đặc Sản Cố Đô Huế";
    ViewData["Description"] = Model.Description ?? $"Mua {Model.Name} chính gốc Cố Đô Huế, cam kết an toàn thực phẩm, giao hàng toàn quốc nhanh chóng.";

    // =========================================================================
    // LOGIC FALLBACK DATA THÔNG MINH THEO TỪNG NHÓM ĐẶC SẢN HUẾ
    // =========================================================================
    var prodName = (Model.Name ?? "").ToLowerInvariant();
    var catName  = (Model.Category?.Name ?? "").ToLowerInvariant();

    bool isTomChua = prodName.Contains("tôm chua") || catName.Contains("tôm chua") || prodName.Contains("mắm");
    bool isMeXung  = prodName.Contains("mè xửng") || prodName.Contains("kẹo") || catName.Contains("mè xửng") || catName.Contains("bánh");
    bool isTra     = prodName.Contains("trà") || prodName.Contains("sen") || catName.Contains("trà");
    bool isNemTre  = prodName.Contains("tré") || prodName.Contains("nem") || prodName.Contains("chả");

    // 1. Thương hiệu / Nhãn hàng
    string brandName = isMeXung  ? "Mè Xửng Cung Đình Thiên Hương"
                     : isTomChua ? "Tôm Chua Cố Đô Trọng Tín"
                     : isTra     ? "Trà Sen Cung Đình Đức Phượng"
                     : isNemTre  ? "Nem Tré Gia Truyền Đông Ba"
                     : "Đặc Sản Cố Đô Huế Chính Gốc";

    // 2. Định lượng tịnh (Net Weight)
    string netWeight = isTomChua ? "Hũ thủy tinh 500g (Khối lượng cái: 350g)"
                     : isMeXung  ? "Hộp quà tặng 450g (Đóng gói từng thanh riêng)"
                     : isTra     ? "Hộp giấy hoàng gia 250g (25 túi lọc tiện lợi)"
                     : isNemTre  ? "Gói 400g (10 chiếc bọc lá ổi truyền thống)"
                     : "Đóng gói tiêu chuẩn 500g";

    // 3. Danh sách thành phần cấu tạo
    string ingredients = isTomChua
        ? "Tôm đất tươi tự nhiên đầm phá Tam Giang (65%), riềng tươi thái chỉ, tỏi tươi củ trắng, ớt chỉ thiên Huế, nước mắm cá cơm nguyên chất, đường mía phèn, muối hầm sạch, thính nếp cái hoa vàng lên men tự nhiên. Tuyệt đối không hàn the, không chất tạo màu nhân tạo."
        : isMeXung
        ? "Mạch nha nếp Kim Long (45%), hạt mè (vừng) rang vàng thơm, đậu phộng (lạc) bùi béo chọn lọc, đường cát tinh luyện, tinh bột nếp dẻo thơm, dầu cọ thực vật tinh luyện, hương vani tự nhiên."
        : isTra
        ? "Tim sen Huế (hạt sen Tịnh Tâm), atiso Đà Lạt, hoa cúc La Mã, hoa nhài sấy lạnh, hoài sơn, cỏ ngọt tự nhiên, cam thảo bắc, táo đỏ, kỷ tử, hoa đại, khổ qua sấy khô theo phương pháp sao thảo dược bí truyền triều Nguyễn."
        : isNemTre
        ? "Thịt đầu heo tươi sạch (tai, mũi, bì heo luộc giòn), củ riềng cay nồng, tỏi củ giã nhuyễn, mè rang vàng, thính gạo rang thơm, lá ổi tươi, tiêu sọ Phú Quốc, gia vị truyền thống Cố Đô."
        : "Nguyên liệu đặc sản tự nhiên xứ Huế chọn lọc loại 1, quy trình chế biến khép kín truyền thống đảm bảo giữ trọn dinh dưỡng và phong vị nguyên bản.";

    // 4. Thông số kỹ thuật bao bì
    string packageSpecs = isTomChua ? "Hũ thủy tinh cao cấp nắp thiếc chuyên dụng, màng seal chống rò rỉ khí (12 x 8.5 x 8.5 cm)"
                        : isMeXung  ? "Hộp giấy Ivory in ấn phủ màng metalize ánh kim, túi màng nhôm phức hợp PA/PE kín khí (22 x 15 x 4 cm)"
                        : isTra     ? "Hộp carton cứng hoa văn cung đình, túi zip bạc bảo quản hương thơm tối đa (18 x 12 x 6 cm)"
                        : "Bao bì thực phẩm đa lớp đạt chuẩn an toàn thực phẩm Quốc gia (PA/PE)";

    // 5. Hướng dẫn sử dụng
    string usageInstruction = isTomChua
        ? "Sản phẩm dùng ăn liền trực tiếp. Ngon nhất khi dùng kèm thịt ba chỉ (ba rọi) luộc thái mỏng, cuốn bánh tráng rau sống, khế chua, chuối chát, dưa leo và bún tươi. Có thể giã thêm chút tỏi ớt đường tùy khẩu vị của quý khách."
        : isMeXung
        ? "Dùng trực tiếp ngay khi mở bao bì từng thanh. Thưởng thức tuyệt vời và trọn vẹn nhất khi nhâm nhi cùng một tách trà sen hoặc trà Cung Đình Huế ấm nóng trong không gian thư thái."
        : isTra
        ? "Cho 10g - 15g trà (hoặc 1 túi lọc) vào ấm, tráng qua nước sôi. Rót 250ml - 300ml nước sôi ở nhiệt độ 90°C - 95°C, đậy nắp hãm từ 3 - 5 phút cho trà ngấm rồi thưởng thức. Có thể uống nóng hoặc thêm đá làm thức uống giải nhiệt thanh mát mỗi ngày."
        : isNemTre
        ? "Bóc lớp lá chuối bên ngoài, trộn đều nem tré cùng tỏi tép, ớt tươi và rau răm. Chấm kèm tương ớt Huế hoặc nước mắm tỏi ớt cay nồng làm món khai vị nhắm rượu tuyệt hảo."
        : "Sử dụng trực tiếp hoặc chế biến theo khẩu vị gia đình. Dùng ngay sau khi mở gói bao bì.";

    // 6. Hướng dẫn bảo quản
    string storageInstruction = isTomChua
        ? "Bảo quản nơi khô ráo, tránh ánh nắng trực tiếp. Sau khi mở nắp, bắt buộc đậy kín nắp và bảo quản trong NGĂN MÁT TỦ LẠNH (nhiệt độ từ 4°C - 8°C) để giữ tôm giữ được màu đỏ au đẹp mắt và độ giòn ngọt thơm ngon tự nhiên lên đến 6 tháng."
        : isMeXung
        ? "Bảo quản nơi khô ráo, thoáng mát, sạch sẽ, tránh ánh nắng mặt trời chiếu trực tiếp và tránh nơi có độ ẩm cao hoặc gần côn trùng. Sau khi xé thanh kẹo nên dùng ngay để giữ độ dẻo giòn thơm của mè."
        : isTra
        ? "Bảo quản trong hộp kín hoặc kéo chặt miệng túi zip sau mỗi lần sử dụng. Đặt nơi khô ráo, thoáng mát, nhiệt độ phòng (dưới 30°C), tránh tiếp xúc với không khí ẩm ướt."
        : "Bảo quản nơi khô mát, sạch sẽ, tránh ánh nắng trực tiếp. Đậy kín sau khi sử dụng.";

    // 7. Cảnh báo an toàn
    string allergenWarning = isTomChua ? "Lưu ý: Không dùng cho người có tiền sử dị ứng với tôm, hải sản giáp xác. Không dùng sản phẩm khi thấy mốc hỏng hoặc có mùi lạ."
                           : isMeXung  ? "Lưu ý: Sản phẩm chứa hạt mè (vừng) và đậu phộng (lạc). Người mẫn cảm hoặc dị ứng với các loại hạt trên cần cân nhắc trước khi dùng."
                           : isTra     ? "Lưu ý: Phụ nữ mang thai trong 3 tháng đầu nên tham khảo ý kiến bác sĩ trước khi sử dụng thảo dược có tính thanh nhiệt mạnh."
                           : "Không sử dụng sản phẩm khi đã quá hạn sử dụng in trên bao bì hoặc bao bì bị rách, xì hơi.";

    // Tính toán giảm giá và giá gạch ngang
    var hasDiscount = Model.OriginalPrice.HasValue && Model.OriginalPrice.Value > Model.Price;
    var discountPercent = hasDiscount
        ? (int)Math.Round((1 - (Model.Price / Model.OriginalPrice!.Value)) * 100)
        : 0;

    // Mã SKU và Barcode mẫu động
    string skuCode = $"HUE-{(Model.CategoryId > 0 ? Model.CategoryId : 1):D2}-{Model.Id:D4}";
    string barcodeNumber = $"8938501{Model.Id:D6}";
}

<div class="container py-4">

    <!-- BREADCRUMB ĐIỀU HƯỚNG -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 rounded-pill bg-light border small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a>
            </li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted">
                        @Model.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">
                @Model.Name
            </li>
        </ol>
    </nav>

    <!-- =========================================================================
         KHU VỰC 1: NỬA TRÊN TRANG – THÔNG TIN NHẬN DIỆN & THƯƠNG MẠI
         ========================================================================= -->
    <div class="card rounded-4 border-0 shadow-sm overflow-hidden p-3 p-md-4 mb-4 bg-white">
        <div class="row g-4 align-items-start">

            <!-- CỘT TRÁI: ẢNH SẢN PHẨM & HUY HIỆU CHẤT LƯỢNG -->
            <div class="col-lg-5 col-md-6">
                <div class="position-relative rounded-4 overflow-hidden border bg-light shadow-xs mb-3 text-center">
                    <img src="@(Model.ImageUrl ?? "/images/placeholder.jpg")"
                         alt="@Model.Name"
                         id="mainProductImage"
                         class="img-fluid w-100 rounded-4 hue-product-detail-img"
                         onerror="this.src='/images/placeholder.jpg'" />

                    <!-- Badge giảm giá -->
                    @if (hasDiscount)
                    {
                        <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill px-3 py-2 shadow-sm fs-6">
                            🔥 Giảm @discountPercent%
                        </span>
                    }

                    <!-- Badge danh mục -->
                    <span class="position-absolute bottom-0 start-0 m-3 badge bg-dark bg-opacity-75 rounded-pill px-3 py-2 small">
                        🏮 @(Model.Category?.Name ?? "Đặc sản Huế")
                    </span>
                </div>

                <!-- CAM KẾT CHẤT LƯỢNG HUẾ -->
                <div class="row g-2 text-center small text-muted">
                    <div class="col-4">
                        <div class="p-2 border rounded-3 bg-light h-100">
                            <div class="fs-4">🌿</div>
                            <div class="fw-semibold text-dark mt-1">100% Tự Nhiên</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">Không chất độc hại</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded-3 bg-light h-100">
                            <div class="fs-4">🏆</div>
                            <div class="fw-semibold text-dark mt-1">Chuẩn Vị Cố Đô</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">Nghệ nhân truyền thống</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded-3 bg-light h-100">
                            <div class="fs-4">🚚</div>
                            <div class="fw-semibold text-dark mt-1">Giao Toàn Quốc</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">Đóng gói kỹ 24h</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: THÔNG TIN THƯƠNG MẠI, GIÁ BÁN, MÃ VẠCH & ĐẶT HÀNG -->
            <div class="col-lg-7 col-md-6">
                
                <!-- THƯƠNG HIỆU & ĐÁNH GIÁ -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold">
                        ⚜️ @brandName
                    </span>
                    <div class="d-flex align-items-center gap-1 text-warning small">
                        <span>⭐⭐⭐⭐⭐</span>
                        <span class="text-muted ms-1">(4.9/5 · 286 đánh giá)</span>
                    </div>
                </div>

                <!-- TÊN SẢN PHẨM -->
                <h1 class="h3 fw-bold text-dark mb-2 hue-title-primary">
                    @Model.Name
                </h1>

                <!-- MÔ TẢ TỔNG QUAN -->
                <p class="text-muted small leading-relaxed mb-3">
                    @(string.IsNullOrWhiteSpace(Model.Description) 
                        ? $"{Model.Name} là thức quà đặc sản tinh hoa của xứ Huế, được chế biến thủ công theo công thức gia truyền nức tiếng, mang lại hương vị thơm ngon khó quên và bổ dưỡng."
                        : Model.Description)
                </p>

                <!-- KHU VỰC HIỂN THỊ GIÁ BÁN NIÊM YẾT -->
                <div class="p-3 bg-light rounded-4 border mb-3">
                    <div class="d-flex align-items-baseline gap-3 flex-wrap">
                        <!-- Giá bán mới màu đỏ Huế -->
                        <span class="fs-2 fw-bold text-danger">
                            @Model.Price.ToString("N0") <span class="fs-5 fw-normal">₫</span>
                        </span>

                        @if (hasDiscount)
                        {
                            <!-- Giá gốc gạch ngang -->
                            <span class="text-muted text-decoration-line-through fs-5">
                                @Model.OriginalPrice!.Value.ToString("N0") ₫
                            </span>
                            <span class="badge bg-danger rounded-pill px-2 py-1 small">
                                Tiết kiệm @((Model.OriginalPrice.Value - Model.Price).ToString("N0")) ₫
                            </span>
                        }
                    </div>
                    <div class="text-muted small mt-1">
                        Đã bao gồm thuế GTGT · Miễn phí đổi trả trong 7 ngày nếu lỗi từ nhà sản xuất.
                    </div>
                </div>

                <!-- KHU VỰC THÔNG SỐ TỒN KHO & HẠN SỬ DỤNG (THEO 01-CODING-STYLE.MD) -->
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 p-2 border rounded-3 bg-white">
                            <span class="fs-4">📅</span>
                            <div>
                                <div class="text-muted" style="font-size: 0.75rem;">Hạn sử dụng (HSD):</div>
                                <div class="fw-bold text-success">@Model.ExpiryDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 p-2 border rounded-3 bg-white">
                            <span class="fs-4">📦</span>
                            <div>
                                <div class="text-muted" style="font-size: 0.75rem;">Tình trạng kho hàng:</div>
                                <div class="fw-bold @(Model.StockQuantity > 0 ? "text-primary" : "text-danger")">
                                    @(Model.StockQuantity > 0 ? $"Còn hàng ({Model.StockQuantity} sản phẩm)" : "Tạm hết hàng")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================================
                     MÃ ĐỊNH DANH SẢN PHẨM: SKU ĐỘNG + MÃ VẠCH (BARCODE) & QR TRUY XUẤT
                     ========================================================================= -->
                <div class="p-3 border rounded-4 bg-white shadow-xs mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <span class="small fw-bold text-dark text-uppercase">
                            🏷️ Mã định danh & Truy xuất nguồn gốc
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small font-monospace">
                            SKU: <strong>@skuCode</strong>
                        </span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 p-2 rounded-3 bg-light border">
                        
                        <!-- MÔ PHỎNG MÃ VẠCH CHUẨN BARCODE CODE 128 -->
                        <div class="d-flex flex-column align-items-center">
                            <div class="hue-barcode-strip" title="Mã vạch EAN-13 chuẩn Quốc gia: @barcodeNumber">
                                <!-- Thanh vạch giả lập SVG chuẩn barcode nét đen trắng -->
                                <svg width="170" height="42" viewBox="0 0 170 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect width="170" height="42" fill="white"/>
                                    <!-- Các vạch barcode song song -->
                                    <rect x="4" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="8" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="15" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="19" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="23" y="2" width="3" height="32" fill="#111"/>
                                    <rect x="28" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="33" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="40" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="44" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="48" y="2" width="3" height="32" fill="#111"/>
                                    <rect x="54" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="59" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="65" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="69" y="2" width="3" height="32" fill="#111"/>
                                    <rect x="74" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="78" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="82" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="89" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="94" y="2" width="3" height="32" fill="#111"/>
                                    <rect x="99" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="103" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="109" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="114" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="118" y="2" width="3" height="32" fill="#111"/>
                                    <rect x="123" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="128" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="135" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="139" y="2" width="3" height="32" fill="#111"/>
                                    <rect x="144" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="149" y="2" width="1" height="32" fill="#111"/>
                                    <rect x="153" y="2" width="4" height="32" fill="#111"/>
                                    <rect x="160" y="2" width="2" height="32" fill="#111"/>
                                    <rect x="165" y="2" width="2" height="32" fill="#111"/>
                                </svg>
                            </div>
                            <span class="small font-monospace text-dark mt-1" style="font-size: 0.78rem; letter-spacing: 1px;">
                                @barcodeNumber
                            </span>
                        </div>

                        <!-- MÃ QR TRUY XUẤT CHỐNG HÀNG GIẢ -->
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-1 bg-white border rounded shadow-xs" title="Mã QR Chống hàng giả & Quản lý kho">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2b2b2b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                    <line x1="18" y1="7" x2="18.01" y2="7"></line>
                                    <line x1="7" y1="18" x2="7.01" y2="18"></line>
                                    <line x1="18" y1="18" x2="18.01" y2="18"></line>
                                    <line x1="10" y1="14" x2="10" y2="17"></line>
                                    <line x1="14" y1="10" x2="17" y2="10"></line>
                                </svg>
                            </div>
                            <div class="small">
                                <div class="fw-semibold text-success" style="font-size: 0.75rem;">🛡️ Tem chống hàng giả</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Mã hóa QR Cố Đô Huế</div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- BỘ CHỌN SỐ LƯỢNG & NÚT THÊM GIỎ HÀNG AJAX -->
                @if (Model.StockQuantity > 0)
                {
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                        
                        <!-- Bộ chọn số lượng -->
                        <div class="d-flex align-items-center border rounded-pill bg-white p-1 shadow-xs">
                            <button type="button" class="btn btn-sm btn-light rounded-circle fw-bold px-2 py-1" onclick="changeQuantity(-1)" aria-label="Giảm số lượng">
