@{
    Layout = null;
    ViewData["Title"] = "Shipper GHN - Quét Mã Vận Đơn";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>GHN Shipper Express - Quét Bưu Kiện</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Thư viện quét mã vạch / QR nguồn mở HTML5-QRCode -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px;
            margin: 0;
            color: #1e293b;
        }

        /* KHUNG GIẢ LẬP MÀN HÌNH ĐIỆN THOẠI DI ĐỘNG CỦA SHIPPER */
        .mobile-shell {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* THANH HEADER ĐIỆN THOẠI (STATUS BAR + APP BAR) */
        .app-header {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            color: #ffffff;
            padding: 18px 20px;
            position: relative;
        }

        .status-notch {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            opacity: 0.85;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .app-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .app-brand-icon {
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(8px);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        /* KHU VỰC QUÉT CAMERA HOẶC VIEWFINDER */
        .scanner-card {
            padding: 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }

        .scanner-viewport {
            width: 100%;
            min-height: 230px;
            background: #090d16;
            border-radius: 18px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px dashed #fdba74;
        }

        /* HIỆU ỨNG TIA LASER QUÉT MÃ VẠCH */
        .scan-laser-line {
            position: absolute;
            width: 86%;
            height: 3px;
            background: linear-gradient(90deg, transparent, #22c55e, #4ade80, transparent);
            box-shadow: 0 0 14px #22c55e;
            top: 20%;
            left: 7%;
            animation: scanLaserAnim 2s ease-in-out infinite alternate;
            z-index: 5;
            pointer-events: none;
        }

        @@keyframes scanLaserAnim {
            0% { top: 15%; opacity: 0.3; }
            50% { opacity: 1; }
            100% { top: 85%; opacity: 0.3; }
        }

        /* HỘP NHẬP LIỆU MÃ VẬN ĐƠN */
        .input-group-custom {
            margin-top: 16px;
        }

        .barcode-input {
            font-family: 'JetBrains Mono', monospace;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.5px;
            border-radius: 12px;
            padding: 12px 14px;
            border: 2px solid #cbd5e1;
            transition: all 0.2s ease;
            text-transform: uppercase;
        }

        .barcode-input:focus {
            border-color: #ea580c;
            box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
        }

        .btn-scan-action {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            color: #ffffff;
            font-weight: 700;
            border-radius: 12px;
            padding: 12px 18px;
            border: none;
            box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);
            transition: transform 0.15s ease;
        }

        .btn-scan-action:active {
            transform: scale(0.97);
        }

        /* THẺ KẾT QUẢ ĐƠN HÀNG SAU KHI QUÉT THÀNH CÔNG */
        .result-panel {
            padding: 20px;
            flex: 1;
            overflow-y: auto;
            max-height: 480px;
        }

        .order-badge-success {
            background-color: #ecfdf5;
            border: 1px solid #a7f3d0;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
            animation: fadeIn 0.3s ease-in-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .history-list {
            margin-top: 16px;
        }

        .history-item {
            font-size: 13px;
            background: #f1f5f9;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* KHỔ ĐIỆN THOẠI THẬT */
        @@media (max-width: 480px) {
            body {
                padding: 0;
                background: #ffffff;
            }
            .mobile-shell {
                max-width: 100%;
                border-radius: 0;
                min-height: 100vh;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>

    <div class="mobile-shell">
        <!-- 1. APP HEADER SHIPPER -->
        <div class="app-header">
            <div class="status-notch">
                <span>📶 5G GHN-EXPRESS</span>
                <span id="liveClock">12:30</span>
                <span>🔋 98%</span>
            </div>
            <div class="app-brand">
                <div class="app-brand-icon">
                    🛵
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="letter-spacing: 0.3px;">GHN Shipper App</h5>
                    <div style="font-size: 12px; opacity: 0.9;">Bưu cục Huế – Điều phối giao hàng</div>
                </div>
                <div class="ms-auto">
                    <span class="badge bg-light text-dark fw-bold px-2.5 py-1.5 rounded-pill shadow-xs" style="font-size: 11px;">
                        🟢 Trực Tuyến
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. KHU VỰC CAMERA QUÉT MÃ VẠCH / QR CODE -->
        <div class="scanner-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold small text-secondary">
                    📷 CAMERA QUÉT MÃ VẬN ĐƠN
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" id="btnToggleCamera" style="font-size: 11px;">
                    ▶ Mở Camera
                </button>
            </div>

            <!-- VIEWPORT CAMERA VÀ TIA LASER -->
            <div class="scanner-viewport" id="scannerViewport">
                <!-- Vùng Camera do Html5Qrcode gắn vào -->
                <div id="cameraReader" style="width: 100%; height: 100%;"></div>

                <div class="scan-laser-line" id="laserLine" style="display: none;"></div>

                <div id="cameraPlaceholder" class="text-center p-3 text-light">
                    <div class="fs-1 mb-2">📦</div>
                    <div class="fw-semibold small">Sẵn sàng nhận diện mã vận đơn</div>
                    <div class="text-secondary" style="font-size: 11px; margin-top: 4px;">
                        Đặt mã vạch K80/A6 vào giữa khung ngắm hoặc nhập tay mã bên dưới
                    </div>
                </div>
            </div>

            <!-- Ô NHẬP TAY NẾU KHÔNG DÙNG CAMERA -->
            <div class="input-group-custom">
                <label for="barcodeInput" class="form-label small fw-semibold text-muted mb-1">
                    Nhập hoặc quét mã bưu kiện tại đây:
                </label>
                <div class="input-group">
                    <input type="text"
                           id="barcodeInput"
                           class="form-control barcode-input"
                           placeholder="Ví dụ: GHN2610160458001"
                           autocomplete="off" />
                    <button class="btn btn-scan-action" type="button" id="btnSubmitScan">
                        ⚡ Quét Mã (Scan)
                    </button>
                </div>
                <div class="form-text text-muted small mt-1">
                    💡 Hỗ trợ: Mã vận đơn GHN, mã đơn hàng <code>HUE-...</code> hoặc số ID đơn.
                </div>
            </div>
        </div>

        <!-- 3. KHU VỰC KẾT QUẢ ĐƠN HÀNG VỪA QUÉT -->
        <div class="result-panel">
            <!-- THÔNG BÁO TRẠNG THÁI -->
            <div id="scanAlertBox" style="display: none;"></div>

            <!-- THẺ CHI TIẾT BƯU KIỆN SAU KHI QUÉT (PHÂN TÁCH LUỒNG ĐA GIAI ĐOẠN LOGISTICS) -->
            <div id="parcelDetailCard" style="display: none;" class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                <!-- PHẦN TỔNG QUAN BƯU KIỆN CHUNG -->
                <div class="card-header text-white p-3 d-flex justify-content-between align-items-center"
                     style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                    <div>
                        <span class="small text-uppercase fw-bold text-warning" style="letter-spacing: 0.5px; font-size: 11px;">
                            📦 CHI TIẾT BƯU KIỆN
                        </span>
                        <div class="fw-bold font-monospace fs-6 text-white" id="resOrderCode">HUE-...</div>
                    </div>
                    <div class="text-end">
                        <span id="parcelStatusBadge" class="badge bg-secondary px-2.5 py-1.5 rounded-pill" style="font-size: 11px;">
                            Đang xử lý
                        </span>
                    </div>
                </div>

                <div class="card-body p-3 bg-white">
                    <!-- Tóm tắt mã vận đơn và tiền COD -->
                    <div class="p-2.5 bg-light rounded-3 mb-3 small">
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-muted">Mã vận đơn GHN:</span>
                            <strong class="font-monospace text-danger fs-6" id="resTrackingCode">GHN...</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-muted">Tiền cần thu (COD):</span>
                            <strong class="text-success" id="resTotalAmount">0đ (Hàng đã thanh toán trước qua payOS)</strong>
                        </div>
                    </div>

                    <!-- ============================================================
                         KHỐI 1 (Dành cho Shipper lấy hàng - Khi status == 2)
                         ============================================================ -->
                    <div id="stage1PickupBox" style="display: none;" class="p-3 bg-primary-subtle rounded-3 border border-primary-subtle mb-2">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary-emphasis">
                            <div class="fs-4">🏢</div>
                            <div>
                                <h6 class="fw-bold mb-0 text-uppercase" style="letter-spacing: 0.3px; font-size: 13px;">
                                    GIAI ĐOẠN 1: TIẾP NHẬN BƯU KIỆN TỪ KHO SHOP
                                </h6>
                                <div class="small text-muted" style="font-size: 11px;">
                                    Bưu kiện đã được đóng gói & sẵn sàng bàn giao cho Shipper lấy hàng.
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-2.5 rounded-2 mb-3 small border border-primary-subtle">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Địa điểm lấy hàng:</span>
                                <strong class="text-dark">Tổng kho Đặc Sản Huế (Kho Shop)</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Trạng thái kho:</span>
                                <span class="badge bg-warning text-dark fw-bold">Chờ shipper lấy hàng (Status = 2)</span>
                            </div>
                        </div>

                        <!-- CHỈ HIỂN THỊ DUY NHẤT MỘT NÚT BẤM LỚN MÀU XANH DƯƠNG -->
                        <button type="button"
                                id="btnConfirmPickup"
                                class="btn btn-primary w-100 fw-bold py-3 shadow-lg rounded-pill fs-6 d-flex align-items-center justify-content-center gap-2"
                                style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border: none; box-shadow: 0 8px 24px rgba(37, 99, 235, 0.45) !important;">
                            📦 Xác nhận đã lấy hàng từ Kho
                        </button>
                    </div>

                    <!-- ============================================================
                         KHỐI 2 (Dành cho Shipper đi giao - Khi status == 3)
                         ============================================================ -->
                    <div id="stage2DeliveryBox" style="display: none;" class="p-3 bg-success-subtle rounded-3 border border-success-subtle mb-2">
                        <div class="d-flex align-items-center gap-2 mb-2 text-success-emphasis">
                            <div class="fs-4">🛵</div>
                            <div>
                                <h6 class="fw-bold mb-0 text-uppercase" style="letter-spacing: 0.3px; font-size: 13px;">
                                    GIAI ĐOẠN 2: XÁC THỰC GIAO HÀNG TẬN TAY KHÁCH
                                </h6>
                                <div class="small text-muted" style="font-size: 11px;">
                                    Shipper giao kiện hàng trực tiếp tới tận tay người nhận.
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-2.5 rounded-2 mb-3 small border border-success-subtle">
                            <div class="d-flex justify-content-between mb-1.5">
                                <span class="text-muted">Người nhận:</span>
                                <strong class="text-dark fs-6" id="resCustomerName">mniem</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1.5">
                                <span class="text-muted">Số điện thoại:</span>
                                <span class="font-monospace text-primary fw-semibold" id="resCustomerPhone">-</span>
                            </div>
                            <div class="mb-1.5">
                                <span class="text-muted">Địa chỉ giao:</span>
                                <div class="fw-semibold text-dark mt-0.5" id="resShippingAddress" style="line-height: 1.4;">
                                    Phường Mỹ Thường
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="text-muted">Tiền cần thu (COD):</span>
                                <strong class="text-success" style="font-size: 13px;">
                                    0đ (Hàng đã thanh toán trước qua payOS)
                                </strong>
                            </div>
                        </div>

                        <!-- Ô NHẬP MÃ OTP BẢO MẬT & CHỈ HIỂN THỊ DUY NHẤT MỘT NÚT BẤM LỚN MÀU XANH LÁ CÂY -->
                        <div id="otpInputSection">
                            <label for="otpCodeInput" class="form-label small fw-bold text-secondary mb-1 d-flex justify-content-between">
                                <span>🔑 Mã OTP xác thực người nhận:</span>
                                <span class="text-muted fw-normal" style="font-size: 11px;">Mặc định số mẫu: <strong>1234</strong></span>
                            </label>
                            <input type="text"
                                   id="otpCodeInput"
                                   class="form-control text-center font-monospace fw-bold fs-4 rounded-3 mb-3"
                                   value="1234"
                                   maxlength="6"
                                   placeholder="Nhập 4 số OTP"
                                   style="letter-spacing: 6px; border: 2px solid #22c55e; background-color: #f0fdf4; color: #15803d;" />

                            <!-- NÚT BẤM LỚN MÀU XANH LÁ CÂY VÔ CÙNG RỰC RỠ -->
                            <button type="button"
                                    id="btnConfirmDelivery"
                                    class="btn btn-success w-100 fw-bold py-3 shadow-lg rounded-pill fs-6 d-flex align-items-center justify-content-center gap-2"
                                    style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); border: none; box-shadow: 0 8px 24px rgba(22, 163, 74, 0.45) !important;">
                                ✅ Xác nhận đã giao cho Khách thành công
                            </button>
                        </div>
                    </div>

                    <!-- ============================================================
                         KHỐI HOÀN TẤT (Khi status == 4)
                         ============================================================ -->
                    <div id="stage3CompletedBox" style="display: none;" class="p-3 text-white rounded-3 text-center mb-2 shadow-sm"
                         style="background: linear-gradient(135deg, #15803d 0%, #166534 100%);">
                        <div class="fs-2 mb-1">🎉</div>
                        <h6 class="fw-bold mb-1">ĐÃ GIAO THÀNH CÔNG - HOÀN TẤT ĐƠN</h6>
                        <div class="small opacity-90">
                            Đơn hàng đã khép kín vòng đời (Status = 4). Doanh thu thực tế đã được chốt và khóa cứng trên toàn hệ thống.
                        </div>
                    </div>

                    <!-- NÚT PHỤ: MỞ LINK TRA CỨU GHN & QUÉT TIẾP -->
                    <div class="mt-3 text-center d-flex gap-2">
                        <a id="btnOpenTracking" href="#" target="_blank" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill fw-semibold py-1.5" style="font-size: 12px;">
                            🔍 Mở Tra Cứu GHN
                        </a>
                        <button type="button" class="btn btn-sm btn-light border rounded-pill px-3" onclick="resetScanForm()">
                            Quét tiếp ➜
                        </button>
                    </div>
                </div>
            </div>

            <!-- DANH SÁCH LỊCH SỬ CÁC ĐƠN ĐÃ QUÉT TRONG CA LÀM VIỆC -->
            <div class="history-list">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small text-secondary">
                        📋 KIỆN ĐÃ TIẾP NHẬN HÔM NAY (<span id="scanCount">0</span>)
                    </span>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Orders" class="small text-decoration-none text-primary" style="font-size: 11px;">
                            Về Quản Trị Admin ➜
                        </a>
                    }
                </div>
                <div id="historyContainer">
                    <div class="text-center text-muted py-3 small" id="historyEmptyText">
                        Chưa có bưu kiện nào được quét trong phiên làm việc này.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPT ĐIỀU KHIỂN SHIPPER SCANNER & AJAX -->
    <script>
        let html5QrScanner = null;
        let isCameraRunning = false;
        let scannedCount = 0;

        // Cập nhật đồng hồ thời gian thực trên thanh status
        function updateClock() {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            const clockEl = document.getElementById('liveClock');
            if (clockEl) clockEl.innerText = `${h}:${m}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Âm thanh Bip khi Shipper quét mã thành công (dùng Web Audio API không cần load file mp3)
        function playBeepSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, ctx.currentTime); // Note A5 (tiếng bíp máy POS)
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.16);
            } catch (e) {
                console.log("AudioContext không khả dụng", e);
            }
        }

        // =========================================================================
        // HÀM GỬI MÃ VẬN ĐƠN VỀ BACKEND XỬ LÝ: /Shipper/ProcessScan
        // =========================================================================
        async function processBarcode(barcode) {
            if (!barcode || !barcode.trim()) {
                showAlert('warning', 'Vui lòng nhập hoặc quét mã bưu kiện.');
                return;
            }

            const cleanCode = barcode.trim().toUpperCase();
            const btn = document.getElementById('btnSubmitScan');
            const originalBtnHtml = btn ? btn.innerHTML : '⚡ Quét Mã (Scan)';

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...`;
            }

            try {
                const response = await fetch('/Shipper/ProcessScan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ barcode: cleanCode })
                });

                const result = await response.json();

                if (result.success) {
                    playBeepSound();
                    showSuccessOrder(result);
                    addScanHistory(result);
                    showAlert('success', result.message);

                    // Tự động xóa ô nhập để chuẩn bị cho lần quét kế tiếp
                    const input = document.getElementById('barcodeInput');
                    if (input) input.value = '';
                } else {
                    showAlert('danger', result.message || 'Không tìm thấy bưu kiện hợp lệ.');
                }
            } catch (err) {
                console.error("Lỗi khi quét bưu kiện:", err);
                showAlert('danger', 'Lỗi kết nối tới máy chủ bưu cục: ' + err.message);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalBtnHtml;
                }
            }
        }

        let currentParcelData = null;

        // Hiển thị thông báo dạng alert
        function showAlert(type, message) {
            const box = document.getElementById('scanAlertBox');
            if (!box) return;
            box.className = `alert alert-${type} py-2 px-3 small rounded-3 mb-3`;
            box.style.display = 'block';
            box.innerHTML = message;
        }

        // =========================================================================
        // HÀM HIỂN THỊ CHI TIẾT BƯU KIỆN THEO ĐIỀU KIỆN TRẠNG THÁI (status)
        // =========================================================================
        function showSuccessOrder(data) {
            currentParcelData = data;
            const card = document.getElementById('parcelDetailCard');
            if (!card) return;

            // Gán dữ liệu cơ bản của bưu kiện
            const orderCodeEl = document.getElementById('resOrderCode');
            if (orderCodeEl) orderCodeEl.innerText = data.orderCode ? ('#' + data.orderCode) : 'N/A';

            const trackingCodeEl = document.getElementById('resTrackingCode');
            if (trackingCodeEl) trackingCodeEl.innerText = data.trackingCode || 'GHN...';

            const customerNameEl = document.getElementById('resCustomerName');
            if (customerNameEl) customerNameEl.innerText = data.customerName || 'mniem';

            const customerPhoneEl = document.getElementById('resCustomerPhone');
            if (customerPhoneEl) customerPhoneEl.innerText = data.customerPhone || 'N/A';

            const shippingAddressEl = document.getElementById('resShippingAddress');
            if (shippingAddressEl) shippingAddressEl.innerText = data.shippingAddress || 'Phường Mỹ Thường';

            const totalAmountEl = document.getElementById('resTotalAmount');
            if (totalAmountEl) totalAmountEl.innerText = '0đ (Hàng đã thanh toán trước qua payOS)';

            const trackingBtn = document.getElementById('btnOpenTracking');
            if (trackingBtn && data.trackingUrl) {
                trackingBtn.href = data.trackingUrl;
            }

            // ---------------------------------------------------------------------
            // LỆNH ĐIỀU KIỆN DỰA TRÊN TRẠNG THÁI (status) CỦA ĐƠN HÀNG
            // ---------------------------------------------------------------------
            const statusVal = parseInt(data.status);
            const stage1Box = document.getElementById('stage1PickupBox');
            const stage2Box = document.getElementById('stage2DeliveryBox');
            const stage3Box = document.getElementById('stage3CompletedBox');
            const statusBadge = document.getElementById('parcelStatusBadge');

            // Ẩn tất cả các khối trước khi mở theo điều kiện
            if (stage1Box) stage1Box.style.display = 'none';
            if (stage2Box) stage2Box.style.display = 'none';
            if (stage3Box) stage3Box.style.display = 'none';

            if (statusVal === 2) {
                // KHỐI 1 (Dành cho Shipper lấy hàng - Khi status == 2)
                if (stage1Box) stage1Box.style.display = 'block';
                if (statusBadge) {
                    statusBadge.className = 'badge bg-warning text-dark fw-bold px-2.5 py-1.5 rounded-pill';
                    statusBadge.innerText = '🟡 Chờ shipper lấy hàng (Status = 2)';
                }
            } else if (statusVal === 3) {
                // KHỐI 2 (Dành cho Shipper đi giao - Khi status == 3)
                if (stage2Box) stage2Box.style.display = 'block';
                if (statusBadge) {
                    statusBadge.className = 'badge bg-primary fw-bold px-2.5 py-1.5 rounded-pill';
                    statusBadge.innerText = '🚚 Đang giao hàng (Status = 3)';
                }

                // Reset ô OTP mẫu
                const otpInput = document.getElementById('otpCodeInput');
                if (otpInput) otpInput.value = '1234';
            } else if (statusVal === 4) {
                // Đơn hàng đã hoàn tất giao hàng
                if (stage3Box) stage3Box.style.display = 'block';
                if (statusBadge) {
                    statusBadge.className = 'badge bg-success fw-bold px-2.5 py-1.5 rounded-pill';
                    statusBadge.innerText = '✅ Đã giao thành công (Status = 4)';
                }
            } else {
                // Trường hợp trạng thái khác, mở Khối 1 mặc định
                if (stage1Box) stage1Box.style.display = 'block';
                if (statusBadge) {
                    statusBadge.className = 'badge bg-secondary px-2.5 py-1.5 rounded-pill';
                    statusBadge.innerText = data.statusText || 'Trạng thái: ' + statusVal;
                }
            }

            card.style.display = 'block';
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Thêm vào danh sách lịch sử trong ca
        function addScanHistory(data, customStatus) {
            scannedCount++;
            const countEl = document.getElementById('scanCount');
            if (countEl) countEl.innerText = scannedCount;

            const emptyText = document.getElementById('historyEmptyText');
            if (emptyText) emptyText.style.display = 'none';

            const container = document.getElementById('historyContainer');
            if (!container) return;

            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
            const statusLabel = customStatus || (data.status === 4 ? 'Đã hoàn tất' : (data.status === 3 ? 'Đang giao' : 'Chờ lấy hàng'));
            const badgeClass = data.status === 4 ? 'bg-success' : (data.status === 3 ? 'bg-primary' : 'bg-warning text-dark');

            const item = document.createElement('div');
            item.className = 'history-item';
            item.innerHTML = `
                <div>
                    <strong>#${data.orderCode}</strong>
                    <span class="text-danger font-monospace ms-1">(${data.trackingCode})</span>
                    <div class="text-muted" style="font-size: 11px;">👤 ${data.customerName || 'Khách hàng'} · 📞 ${data.customerPhone || 'N/A'}</div>
                </div>
                <div class="text-end">
                    <span class="badge ${badgeClass} rounded-pill" style="font-size: 10px;">${statusLabel}</span>
                    <div class="text-secondary" style="font-size: 10px; margin-top: 2px;">${timeStr}</div>
                </div>
            `;
            container.prepend(item);
        }

        // Reset form để quét đơn tiếp theo
        function resetScanForm() {
            const input = document.getElementById('barcodeInput');
            if (input) {
                input.value = '';
                input.focus();
            }
            const box = document.getElementById('scanAlertBox');
            if (box) box.style.display = 'none';

            const card = document.getElementById('parcelDetailCard');
            if (card) card.style.display = 'none';

            currentParcelData = null;
        }

        // Bắt sự kiện bấm nút Scan
        document.getElementById('btnSubmitScan').addEventListener('click', function () {
            const input = document.getElementById('barcodeInput');
            if (input) processBarcode(input.value);
        });

        // Bắt sự kiện nhấn phím Enter trên ô input
        document.getElementById('barcodeInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                processBarcode(this.value);
            }
        });

        // =========================================================================
        // NÚT KHỐI 1: '📦 Xác nhận đã lấy hàng từ Kho' – Chuyển Status = 3 & Bắn Email 3
        // =========================================================================
        const btnConfirmPickup = document.getElementById('btnConfirmPickup');
        if (btnConfirmPickup) {
            btnConfirmPickup.addEventListener('click', async function () {
                const trackingCodeEl = document.getElementById('resTrackingCode');
                const trackingCode = trackingCodeEl ? trackingCodeEl.innerText.trim() : '';

                if (!trackingCode || trackingCode === 'GHN...' || trackingCode === 'N/A') {
                    showAlert('warning', 'Không xác định được mã vận đơn để nhận hàng từ kho.');
                    return;
                }

                const originalBtnHtml = btnConfirmPickup.innerHTML;
                btnConfirmPickup.disabled = true;
                btnConfirmPickup.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Đang xác nhận lấy hàng & gửi Email...`;

                try {
                    const response = await fetch('/Shipper/ConfirmPickup', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            barcode: trackingCode
                        })
                    });

                    const result = await response.json();
                    if (result.success) {
                        playBeepSound();
                        showAlert('success', result.message || 'Đã xác nhận lấy hàng từ Kho! Đơn hàng chuyển sang Status = 3.');

                        // Cập nhật trạng thái đơn hàng sang Status = 3 và hiển thị KHỐI 2
                        if (currentParcelData) {
                            currentParcelData.status = 3;
                            if (result.customerName) currentParcelData.customerName = result.customerName;
                            if (result.shippingAddress) currentParcelData.shippingAddress = result.shippingAddress;
                            showSuccessOrder(currentParcelData);
                        } else {
                            result.status = 3;
                            showSuccessOrder(result);
                        }

                        addScanHistory(result, 'Đã lấy từ kho (Status = 3)');
                    } else {
                        showAlert('danger', result.message || 'Xác nhận lấy hàng từ kho thất bại.');
                    }
                } catch (err) {
                    console.error("Lỗi khi xác nhận lấy hàng từ kho:", err);
                    showAlert('danger', 'Lỗi kết nối tới máy chủ khi nhận hàng từ kho: ' + err.message);
                } finally {
                    btnConfirmPickup.disabled = false;
                    btnConfirmPickup.innerHTML = originalBtnHtml;
                }
            });
        }

        // =========================================================================
        // NÚT KHỐI 2: '✅ Xác nhận đã giao cho Khách thành công' – Chuyển Status = 4 & Khóa doanh thu
        // =========================================================================
        const btnConfirmDeliv = document.getElementById('btnConfirmDelivery');
        if (btnConfirmDeliv) {
            btnConfirmDeliv.addEventListener('click', async function () {
                const trackingCodeEl = document.getElementById('resTrackingCode');
                const trackingCode = trackingCodeEl ? trackingCodeEl.innerText.trim() : '';
                const otpInput = document.getElementById('otpCodeInput');
                const otpCode = otpInput ? otpInput.value.trim() : '1234';

                if (!trackingCode || trackingCode === 'GHN...' || trackingCode === 'N/A') {
                    showAlert('warning', 'Không xác định được mã vận đơn để hoàn tất giao hàng.');
                    return;
                }

                const originalBtnHtml = btnConfirmDeliv.innerHTML;
                btnConfirmDeliv.disabled = true;
                btnConfirmDeliv.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Đang xác thực đơn hàng & chốt doanh thu...`;

                try {
                    const response = await fetch('/Shipper/ConfirmDelivery', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            trackingCode: trackingCode,
                            otpCode: otpCode
                        })
                    });

                    const result = await response.json();
                    if (result.success) {
                        playBeepSound();
                        showAlert('success', result.message || 'Đã xác nhận giao hàng thành công! Đơn hàng đã khép kín vòng đời (Status = 4).');

                        // Cập nhật trạng thái đơn hàng sang Status = 4 và hiển thị KHỐI HOÀN TẤT
                        if (currentParcelData) {
                            currentParcelData.status = 4;
                            showSuccessOrder(currentParcelData);
                        } else {
                            result.status = 4;
                            showSuccessOrder(result);
                        }

                        addScanHistory(result, 'Đã giao thành công (Status = 4)');
                    } else {
                        showAlert('danger', result.message || 'Xác nhận giao hàng thất bại.');
                    }
                } catch (err) {
                    console.error("Lỗi khi xác nhận giao hàng:", err);
                    showAlert('danger', 'Lỗi kết nối tới máy chủ khi xác nhận giao hàng: ' + err.message);
                } finally {
                    btnConfirmDeliv.disabled = false;
                    btnConfirmDeliv.innerHTML = originalBtnHtml;
                }
            });
        }

        // =========================================================================
        // KHỞI TẠO MỞ CAMERA WEBCAM / ĐIỆN THOẠI QUÉT TRỰC TIẾP
        // =========================================================================
        const btnToggle = document.getElementById('btnToggleCamera');
        const laser = document.getElementById('laserLine');
        const placeholder = document.getElementById('cameraPlaceholder');

        btnToggle.addEventListener('click', async function () {
            if (isCameraRunning) {
                stopCamera();
            } else {
                startCamera();
            }
        });

        async function startCamera() {
            if (typeof Html5Qrcode === 'undefined') {
                alert("Thư viện quét mã vạch đang tải hoặc bị chặn. Bạn hãy nhập tay mã vào ô bên dưới!");
                return;
            }

            try {
                html5QrScanner = new Html5Qrcode("cameraReader");
                const config = {
                    fps: 15,
                    qrbox: { width: 250, height: 160 },
                    aspectRatio: 1.5
                };

                placeholder.style.display = 'none';
                laser.style.display = 'block';

                await html5QrScanner.start(
                    { facingMode: "environment" }, // Ưu tiên camera sau của điện thoại
                    config,
                    (decodedText, decodedResult) => {
                        console.log("Quét được mã:", decodedText);
                        // Điền mã vào input và kích hoạt xử lý
                        document.getElementById('barcodeInput').value = decodedText;
                        processBarcode(decodedText);
                    },
                    (errorMessage) => {
                        // Lỗi nhận diện từng frame (bình thường trong quá trình lia máy)
                    }
                );

                isCameraRunning = true;
                btnToggle.innerText = '⏹ Tắt Camera';
                btnToggle.className = 'btn btn-sm btn-danger rounded-pill px-2.5 py-0.5';
            } catch (err) {
                console.error("Không thể mở camera:", err);
                placeholder.style.display = 'block';
                laser.style.display = 'none';
                alert("Không thể truy cập camera (Có thể do chưa cấp quyền hoặc đang chạy trên HTTP thông thường). Bạn có thể gõ trực tiếp mã vào ô bên dưới!");
            }
        }

        async function stopCamera() {
            if (html5QrScanner && isCameraRunning) {
                try {
                    await html5QrScanner.stop();
                    html5QrScanner.clear();
                } catch (e) {
                    console.log("Dừng camera lỗi:", e);
                }
            }
            isCameraRunning = false;
            laser.style.display = 'none';
            placeholder.style.display = 'block';
            btnToggle.innerText = '▶ Mở Camera';
            btnToggle.className = 'btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5';
        }
    </script>
</body>
</html>
