@{
    Layout = null;
    ViewData["Title"] = "Màn hình khóa nội bộ - Đồ án tốt nghiệp";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🔒 HỆ THỐNG KIỂM THỬ NỘI BỘ - ĐỒ ÁN TỐT NGHIỆP | EcommerceHue</title>
    
    <!-- Google Fonts Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-hue: #581c87;
            --accent-gold: #f59e0b;
        }

        * {
            box-sizing: border-box;
            user-select: none;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #090d16 radial-gradient(circle at 50% 30%, #2e1065 0%, #090d16 80%);
            color: #ffffff;
            overflow: hidden;
            position: relative;
        }

        /* HÌNH NỀN AMBIENT LIGHTING HIỆU ỨNG PHÁT SÁNG */
        .ambient-glow {
            position: absolute;
            top: -20%;
            left: 50%;
            transform: translateX(-50%);
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.25) 0%, rgba(88, 28, 135, 0) 70%);
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-glow-bottom {
            position: absolute;
            bottom: -30%;
            right: 10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(234, 88, 12, 0.18) 0%, rgba(0, 0, 0, 0) 70%);
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 1;
        }

        /* MÀN HÌNH KHÓA CHÍNH */
        .lock-container {
            position: relative;
            z-index: 10;
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 20px;
            backdrop-filter: blur(10px);
        }

        /* ĐỒNG HỒ WINDOWS LOCK SCREEN */
        .lock-clock-section {
            text-align: center;
            margin-top: 20px;
            transition: all 0.3s ease;
        }

        .live-time {
            font-family: 'Outfit', sans-serif;
            font-size: 4.5rem;
            font-weight: 700;
            letter-spacing: -2px;
            line-height: 1;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        .live-date {
            font-size: 1.15rem;
            font-weight: 400;
            color: #cbd5e1;
            margin-top: 8px;
            letter-spacing: 0.5px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        }

        /* THẺ ĐĂNG NHẬP GLASSMORPHISM */
        .glass-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-radius: 28px;
            padding: 36px 32px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.2);
            text-align: center;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* AVATAR BIỂU TƯỢNG HUẾ */
        .avatar-shield {
            width: 90px;
            height: 90px;
            margin: 0 auto 16px auto;
            border-radius: 50%;
            background: linear-gradient(135deg, #7e22ce 0%, #3b0764 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            border: 3px solid rgba(245, 158, 11, 0.7);
            box-shadow: 0 10px 25px rgba(126, 34, 206, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.3);
            position: relative;
        }

        .avatar-badge-status {
            position: absolute;
            bottom: 2px;
            right: 4px;
            width: 18px;
            height: 18px;
            background-color: #22c55e;
            border: 2px solid #0f172a;
            border-radius: 50%;
            box-shadow: 0 0 10px #22c55e;
        }

        .system-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.15rem;
            font-weight: 800;
            color: #fbbf24;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 4px;
            text-shadow: 0 2px 10px rgba(245, 158, 11, 0.3);
        }

        .system-subtitle {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-bottom: 22px;
            font-weight: 500;
        }

        /* Ô NHẬP MẬT KHẨU WINDOWS STYLE */
        .password-input-group {
            position: relative;
            margin-bottom: 16px;
        }

        .password-input {
            width: 100%;
            background: rgba(15, 23, 42, 0.75);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            padding: 14px 50px 14px 22px;
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: 2px;
            outline: none;
            transition: all 0.2s ease;
        }

        .password-input:focus {
            border-color: #a855f7;
            background: rgba(15, 23, 42, 0.95);
            box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.3);
        }

        .password-input::placeholder {
            color: #64748b;
            font-weight: 400;
            letter-spacing: 0;
            font-size: 0.92rem;
        }

        .btn-unlock-arrow {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 12px rgba(126, 34, 206, 0.4);
        }

        .btn-unlock-arrow:hover {
            transform: translateY(-50%) scale(1.05);
            box-shadow: 0 6px 18px rgba(168, 85, 247, 0.6);
        }

        .btn-unlock-arrow:active {
            transform: translateY(-50%) scale(0.95);
        }

        /* HINT GỢI Ý THẦY CÔ */
        .hint-box {
            background: rgba(245, 158, 11, 0.1);
            border: 1px dashed rgba(245, 158, 11, 0.4);
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.8rem;
            color: #fde68a;
            margin-top: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        /* FOOTER BẢO VỆ */
        .lock-footer {
            text-align: center;
            font-size: 0.8rem;
            color: #64748b;
            letter-spacing: 0.3px;
        }

        .lock-footer a {
            color: #94a3b8;
            text-decoration: none;
        }

        /* HIỆU ỨNG RUNG KHI NHẬP SAI MẬT KHẨU */
        .shake-animation {
            animation: shake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }

        @@keyframes shake {
            10%, 90% { transform: translate3d(-2px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }

        @@media (max-height: 650px) {
            .live-time { font-size: 3rem; }
            .live-date { font-size: 0.9rem; }
            .avatar-shield { width: 70px; height: 70px; font-size: 2rem; }
            .glass-card { padding: 24px; }
        }
    </style>
</head>
<body>

    <div class="ambient-glow"></div>
    <div class="ambient-glow-bottom"></div>

    <div class="lock-container">
        
        <!-- 1. ĐỒNG HỒ THỜI GIAN THỰC (LOCK SCREEN CLOCK) -->
        <div class="lock-clock-section">
            <div class="live-time" id="lockTime">13:30</div>
            <div class="live-date" id="lockDate">Chủ Nhật, ngày 18 tháng 10 năm 2026</div>
        </div>

        <!-- 2. KHUNG NHẬP MẬT KHẨU BẢO VỆ STAGING ĐÓNG -->
        <div class="glass-card @(ViewBag.ErrorMessage != null ? "shake-animation" : "")">
            
            <!-- BIỂU TƯỢNG HUẾ VÀ TRẠNG THÁI KHÓA -->
            <div class="avatar-shield">
                🏯
                <div class="avatar-badge-status" title="Hệ thống đang hoạt động an toàn"></div>
            </div>

            <div class="system-title">
                HỆ THỐNG KIỂM THỬ NỘI BỘ
            </div>
            <div class="system-subtitle">
                ĐỒ ÁN TỐT NGHIỆP – PHÂN HỆ ECOMMERCEHUE
            </div>

            @if (ViewBag.ErrorMessage != null || !ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger-emphasis d-flex align-items-center gap-2 text-start">
                    <span>⚠️</span>
                    <div>@(ViewBag.ErrorMessage ?? ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage ?? "Mật khẩu truy cập nội bộ chưa chính xác!")</div>
                </div>
            }

            <form method="post" action="/Account/StagingLogin" autocomplete="off">
                <div class="password-input-group">
                    <input type="password"
                           name="accessPassword"
                           id="accessPassword"
                           class="password-input"
                           placeholder="Nhập mã PIN / Mật khẩu..."
                           autofocus
                           required />
                    <button type="submit" class="btn-unlock-arrow" title="Mở khóa hệ thống">
                        ➜
                    </button>
                </div>

                <button type="submit" class="btn btn-outline-light w-100 rounded-pill py-2.5 fw-semibold small mt-1 shadow-xs" style="border-color: rgba(255,255,255,0.25);">
                    🔓 Mở Khóa Truy Cập Vào Website
                </button>
            </form>

            <div class="mt-3 small text-muted" style="font-size: 0.78rem;">
                🛡️ Cổng Staging bảo mật đa lớp chống lộ thông tin trước ngày nghiệm thu.
            </div>
        </div>

        <!-- 3. FOOTER BẢN QUYỀN HỆ THỐNG -->
        <div class="lock-footer">
            <div>ASP.NET Core 9 MVC Architecture · Bảo mật Pipeline Middleware · Cổng thanh toán payOS</div>
            <div class="opacity-75 mt-1">© 2026 EcommerceHue. Tinh Hoa Đặc Sản Xứ Huế.</div>
        </div>

    </div>

    <script>
        // Đồng hồ thời gian thực tự động cập nhật từng giây
        function updateClock() {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            
            const timeEl = document.getElementById('lockTime');
            if (timeEl) timeEl.innerText = `${h}:${m}`;

            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dayName = days[now.getDay()];
            const dateStr = `${dayName}, ngày ${now.getDate()} tháng ${now.getMonth() + 1} năm ${now.getFullYear()}`;
            
            const dateEl = document.getElementById('lockDate');
            if (dateEl) dateEl.innerText = dateStr;
        }

        setInterval(updateClock, 1000);
        updateClock();

        // Tự động focus vào ô nhập mật khẩu
        window.addEventListener('DOMContentLoaded', () => {
            const input = document.getElementById('accessPassword');
            if (input) input.focus();
        });
    </script>
</body>
</html>
