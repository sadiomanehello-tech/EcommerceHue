<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

@model List<EcommerceHue.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    var cartItems     = Model ?? new List<EcommerceHue.Models.CartItem>();
    var totalAmount   = cartItems.Sum(i => i.Total);
    var totalItems    = cartItems.Sum(i => i.Quantity);
}

<!-- ============================================================
     TIÊU ĐỀ TRANG GIỎ HÀNG
     ============================================================ -->
<div class="hue-cart-header d-flex align-items-center gap-3 mb-4">
    <div class="hue-cart-icon-wrap">
        <span class="hue-cart-icon">🛒</span>
    </div>
    <div>
        <h1 class="h3 fw-bold mb-0">Giỏ hàng của bạn</h1>
        <p class="text-muted small mb-0">
            @if (cartItems.Any())
            {
                <span>@totalItems sản phẩm · Tổng: <strong class="text-danger">@totalAmount.ToString("N0") ₫</strong></span>
            }
            else
            {
                <span>Chưa có sản phẩm nào trong giỏ</span>
            }
        </p>
    </div>
    <div class="ms-auto">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
            ← Tiếp tục mua sắm
        </a>
    </div>
</div>

<!-- ============================================================
     THÔNG BÁO (TempData alerts)
     ============================================================ -->
@if (TempData["CartSuccess"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["CartWarning"] is string warningMsg)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        @warningMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["CartError"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!cartItems.Any())
{
    <!-- Giỏ hàng trống -->
    <div class="hue-cart-empty text-center py-5 rounded-4 bg-light">
        <div class="hue-empty-icon mb-3 fs-1">🛍️</div>
        <h3 class="text-muted fw-semibold">Giỏ hàng đang trống</h3>
        <p class="text-muted mb-4">Hãy khám phá các đặc sản Huế và thêm vào giỏ hàng nhé!</p>
        <a asp-controller="Home" asp-action="Index"
           class="btn btn-warning btn-lg fw-semibold px-5 rounded-pill shadow-sm">
            🏮 Khám phá đặc sản Huế
        </a>
    </div>
}
else
{
    <div class="row g-4">

        <!-- ============================================================
             CỘT TRÁI: BẢNG SẢN PHẨM GIỎ HÀNG
             ============================================================ -->
        <div class="col-lg-8">
            <div class="hue-cart-table-wrap rounded-4 shadow-sm overflow-hidden border">
                <table class="table hue-cart-table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width:70px"></th>
                            <th>Đặc sản</th>
                            <th class="text-center" style="width:140px">Đơn giá</th>
                            <th class="text-center" style="width:160px">Số lượng</th>
                            <th class="text-end" style="width:140px">Thành tiền</th>
                            <th style="width:60px" class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in cartItems)
                        {
                            <tr class="hue-cart-row" id="cart-row-@item.ProductId">
                                <!-- Ảnh thu nhỏ -->
                                <td class="ps-4 py-3 align-middle">
                                    <div class="hue-cart-thumb-wrap">
                                        <img src="@(item.ImageUrl ?? "/images/placeholder.jpg")"
                                             alt="@item.ProductName"
                                             class="hue-cart-thumb rounded-3 shadow-xs"
                                             style="width: 52px; height: 52px; object-fit: cover;"
                                             onerror="this.src='/images/placeholder.jpg'" />
                                    </div>
                                </td>

                                <!-- Tên sản phẩm -->
                                <td class="py-3 align-middle">
                                    <div class="fw-semibold hue-cart-name text-dark">@item.ProductName</div>
                                    <div class="small text-muted">Đặc sản Huế</div>
                                </td>

                                <!-- Đơn giá -->
                                <td class="text-center align-middle">
                                    <span class="text-danger fw-semibold">
                                        @item.Price.ToString("N0") ₫
                                    </span>
                                </td>

                                <!-- Ô nhập số lượng với nút tăng/giảm -->
                                <td class="text-center align-middle">
                                    <form asp-action="UpdateQuantity" method="post"
                                          class="hue-qty-form d-flex align-items-center justify-content-center gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                onclick="adjustQty(this, -1)"
                                                title="Giảm">−</button>

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="0"
                                               class="form-control hue-qty-input text-center fw-bold"
                                               id="quantity-input-@item.ProductId"
                                               data-product-id="@item.ProductId"
                                               style="max-width: 70px;"
                                               onchange="this.form.submit()" />

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                onclick="adjustQty(this, 1)"
                                                title="Tăng">+</button>
                                    </form>
                                </td>

                                <!-- Thành tiền -->
                                <td class="text-end align-middle pe-3">
                                    <span class="fw-bold text-dark fs-6">
                                        @item.Total.ToString("N0") ₫
                                    </span>
                                </td>

                                <!-- Nút xóa -->
                                <td class="text-center align-middle">
                                    <form asp-action="RemoveFromCart" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm rounded-circle"
                                                title="Xóa khỏi giỏ"
                                                onclick="return confirm('Xóa @item.ProductName khỏi giỏ hàng?')">
                                            🗑️
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Nút xóa toàn bộ giỏ hàng -->
            <div class="mt-3 text-end">
                <form asp-action="Clear" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-outline-danger btn-sm rounded-pill"
                            onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?')">
                        🗑️ Xóa toàn bộ giỏ
                    </button>
                </form>
            </div>
        </div>

        <!-- ============================================================
             CỘT PHẢI: TÓM TẮT ĐƠN HÀNG & THANH TOÁN
             ============================================================ -->
        <div class="col-lg-4">
            <div class="hue-order-summary rounded-4 shadow-sm p-4 border bg-white sticky-top" style="top: 1.5rem;">

                <h2 class="h5 fw-bold mb-4 pb-2 border-bottom text-dark">📋 Tóm tắt đơn hàng</h2>

                <!-- Chi tiết tính tiền -->
                <div class="hue-summary-row d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính (@totalItems sản phẩm)</span>
                    <span class="fw-semibold">@totalAmount.ToString("N0") ₫</span>
                </div>
                <div class="hue-summary-row d-flex justify-content-between mb-2">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span class="text-success fw-semibold">Miễn phí</span>
                </div>

                <hr class="my-3" />

                <!-- Tổng cộng -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold fs-6">Tổng thanh toán</span>
                    <span class="fw-bold fs-5 text-danger">@totalAmount.ToString("N0") ₫</span>
                </div>

                <!-- Nút Tiến hành đặt hàng & Thanh toán -->
                <a href="/Cart/Checkout"
                   id="btnSubmitCheckout"
                   class="btn btn-warning w-100 fw-bold rounded-pill py-3 mb-3 text-dark shadow-sm fs-6">
                    <span class="me-2">💳</span>
                    Tiến hành Đặt hàng &amp; Thanh toán
                </a>

                <!-- Tiếp tục mua sắm -->
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-outline-secondary w-100 rounded-pill">
                    ← Tiếp tục mua sắm
                </a>

                <!-- Cam kết thanh toán an toàn -->
                <div class="hue-secure-badge mt-4 text-center border-top pt-3">
                    <span class="text-muted small">🔒 Thanh toán an toàn qua mã QR code bảo mật</span>
                </div>
            </div>
        </div>

    </div>
}

<!-- ============================================================
     STYLES RIÊNG & HIỆU ỨNG VIỀN ĐỎ CHỚP NHÁY
     ============================================================ -->
@section Styles {
<style>
    .hue-cart-header { padding: .75rem 0; }
    .hue-cart-icon-wrap {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, #fff3cd, #ffe08a);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
    }
    .hue-summary-row { font-size: .95rem; }

    /* Hiệu ứng CSS chớp nháy đỏ vào khung đường viền ô nhập số lượng bị lỗi */
    @@keyframes pulseRedBorder {
        0% {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7) !important;
        }
        50% {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 8px rgba(220, 53, 69, 0) !important;
        }
        100% {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7) !important;
        }
    }
    .hue-qty-input.border-danger,
    .hue-qty-input.is-invalid {
        border: 2px solid #dc3545 !important;
        animation: pulseRedBorder 1.2s infinite ease-in-out !important;
        background-color: #fff5f5 !important;
    }
</style>
}

<!-- ============================================================
     JAVASCRIPT AJAX XỬ LÝ CHECKOUT & SWEETALERT2 HOẠT HỌA RUNG LẮC
     ============================================================ -->
@section Scripts {
<script>
    /**
     * Tăng/giảm giá trị ô input số lượng và tự submit form để cập nhật Session.
     */
    function adjustQty(btn, delta) {
        const form  = btn.closest('form');
        const input = form.querySelector('input[name="quantity"]');
        const newVal = parseInt(input.value, 10) + delta;
        input.value = Math.max(0, newVal);
        form.submit();
    }

    async function handleCheckout() {
        // Xóa các cảnh báo viền đỏ cũ
        document.querySelectorAll('.hue-qty-input').forEach(input => {
            input.classList.remove('is-invalid', 'border-danger');
        });

        const btnCheckout = document.getElementById('btnSubmitCheckout');
        let originalBtnHtml = '';
        if (btnCheckout) {
            originalBtnHtml = btnCheckout.innerHTML;
            btnCheckout.classList.add('disabled');
            btnCheckout.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang kiểm tra tồn kho...';
        }

        try {
            // Gửi yêu cầu đặt hàng ngầm lên Backend kiểm tra kho
            var response = await fetch('/Cart/Checkout', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            var result = await response.json();
            
            if (result.success) {
                // Nếu kho đủ hàng, bẻ hướng sang link hóa đơn thanh toán của payOS hoặc Checkout
                window.location.href = result.checkoutUrl || '/Cart/Checkout';
            } else {
                // Nếu vượt quá tồn kho, kích hoạt Pop-up SweetAlert2 lớn ở giữa màn hình rung lắc mạnh dữ dội
                Swal.fire({
                    icon: 'error',
                    title: 'Vượt Quá Tồn Kho!',
                    text: result.message, // Hiển thị chuỗi: "Sản phẩm hiện tại chỉ còn đúng 30 hũ trong kho..."
                    confirmButtonText: 'Tôi đã hiểu & Để tôi sửa lại',
                    confirmButtonColor: '#dc3545',
                    showClass: { popup: 'animate__animated animate__shakeX' } // Hiệu ứng lắc động mạnh gây chú ý
                });
                
                // Đồng thời chớp đỏ viền ô nhập số lượng bị lỗi
                var targetId = result.productId ? ('quantity-input-' + result.productId) : null;
                var inputErr = (targetId ? document.getElementById(targetId) : null) || document.querySelector('[id^="quantity-input-"]');
                if (inputErr) {
                    inputErr.classList.add('is-invalid', 'border-danger');
                    inputErr.focus();
                    inputErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        } catch (err) {
            console.error('[Checkout Error]:', err);
            // Fallback chuyển trang nếu có sự cố
            window.location.href = '/Cart/Checkout';
        } finally {
            if (btnCheckout) {
                btnCheckout.classList.remove('disabled');
                btnCheckout.innerHTML = originalBtnHtml;
            }
        }
    }

    // Gắn sự kiện click cho nút Tiến hành Đặt hàng & Thanh toán
    document.addEventListener('DOMContentLoaded', function () {
        var btnCheckout = document.getElementById('btnSubmitCheckout');
        if (btnCheckout) {
            btnCheckout.addEventListener('click', function(e) {
                e.preventDefault();
                handleCheckout();
            });
        }

        // Bắt cảnh báo nếu có từ TempData
        @if (TempData["CartWarning"] is string warning)
        {
            <text>
            Swal.fire({
                icon: 'error',
                title: 'Vượt Quá Tồn Kho!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(warning)),
                confirmButtonText: 'Tôi đã hiểu & Để tôi sửa lại',
                confirmButtonColor: '#dc3545',
                showClass: { popup: 'animate__animated animate__shakeX' }
            });
            </text>
        }
    });
</script>
}
