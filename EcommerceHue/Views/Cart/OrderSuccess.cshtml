@model EcommerceHue.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công - Thanh toán VietQR";
    decimal parsedAmount = decimal.Parse(TempData["TotalAmount"]?.ToString() ?? "0");
    decimal totalAmount = parsedAmount > 0 ? parsedAmount : Model.TotalAmount;
    var paymentContent = TempData["PaymentContent"]?.ToString() 
        ?? TempData["TransferContent"]?.ToString() 
        ?? $"DH{Model.Id}ECOMMERCEHUE";
    var qrUrl = TempData["QrUrl"]?.ToString() 
        ?? $"https://img.vietqr.io/image/970418-8811843594-compact2.png?amount={(long)totalAmount}&addInfo={paymentContent}&accountName=HO%20ANH%20TAI";
    var bankName = TempData["BankName"]?.ToString() ?? "BIDV (Ngân hàng TMCP Đầu tư và Phát triển Việt Nam)";
    var accountNo = TempData["AccountNo"]?.ToString() ?? "8811843594";
    var accountName = TempData["AccountName"]?.ToString() ?? "HO ANH TAI";
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <!-- Header Thông báo thành công -->
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #8b3012 0%, #5c200c 100%);">
                    <div class="display-5 mb-2">🎉</div>
                    <h1 class="h3 fw-bold mb-1">Đặt Hàng Thành Công!</h1>
                    <p class="mb-0 text-white-50 small">Cảm ơn bạn đã lựa chọn đặc sản chính gốc Cố Đô Huế tại <strong>EcommerceHue</strong>.</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- KHỐI THANH TOÁN VIETQR NỔI BẬT -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(180deg, #fffdf8 0%, #fff8eb 100%); border: 1px solid #ffe8cc !important;">
                        <div class="card-body p-4 text-center">

                            <!-- Huy hiệu VietQR & Napas -->
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                                <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill">
                                    <i class="bi bi-qr-code-scan me-1"></i> VietQR Chuyển Khoản Tự Động
                                </span>
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill fw-bold">
                                    Napas 247
                                </span>
                            </div>

                            <!-- Lời nhắc hướng dẫn của VNPAY/VietQR -->
                            <div class="alert alert-warning border-0 rounded-3 mb-3 py-2 px-3 small text-start">
                                <i class="bi bi-info-circle-fill text-warning me-1"></i>
                                <strong>Hướng dẫn:</strong> Vui lòng mở ứng dụng Ngân hàng (App Ngân hàng) quét mã QR dưới đây để hoàn tất thanh toán cho Đặc sản Huế.
                            </div>

                            <!-- Thẻ ảnh hiển thị mã QR động theo đúng yêu cầu -->
                            <div class="position-relative d-inline-block my-2">
                                <img src="@qrUrl"
                                     class="img-fluid img-thumbnail d-block mx-auto shadow-sm rounded-4 border-2 border-warning"
                                     style="max-width: 300px; width: 100%;"
                                     alt="Mã VietQR Thanh Toán" />
                                <div class="small text-muted mt-2">
                                    <i class="bi bi-shield-check text-success"></i> Tự động điền đúng số tiền và nội dung chuyển khoản
                                </div>
                            </div>

                            <!-- KHUNG THÔNG TIN CHUYỂN KHOẢN THÔ (Hỗ trợ Copy thủ công) -->
                            <div class="mt-4 text-start bg-white p-3 p-md-4 rounded-3 border">
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <h3 class="h6 fw-bold text-uppercase text-dark mb-0">
                                        <i class="bi bi-bank text-primary me-1"></i> Thông tin chuyển khoản thủ công
                                    </h3>
                                    <span class="badge bg-light text-muted border">Nhập tay nếu không quét được QR</span>
                                </div>

                                <div class="row g-2 small">
                                    <!-- Ngân hàng -->
                                    <div class="col-sm-4 text-muted">Ngân hàng thụ hưởng:</div>
                                    <div class="col-sm-8 fw-bold text-dark">@bankName</div>

                                    <!-- Số tài khoản -->
                                    <div class="col-sm-4 text-muted">Số tài khoản:</div>
                                    <div class="col-sm-8 d-flex align-items-center justify-content-between">
                                        <strong class="fs-6 text-primary" id="copy-acc">@accountNo</strong>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="copyText('copy-acc', this)">
                                            <i class="bi bi-clipboard"></i> Sao chép
                                        </button>
                                    </div>

                                    <!-- Tên chủ tài khoản -->
                                    <div class="col-sm-4 text-muted">Chủ tài khoản:</div>
                                    <div class="col-sm-8 fw-bold text-dark">@accountName</div>

                                    <!-- Số tiền -->
                                    <div class="col-sm-4 text-muted">Số tiền cần chuyển:</div>
                                    <div class="col-sm-8 d-flex align-items-center justify-content-between">
                                        <strong class="fs-5 text-danger fw-bold" id="copy-amount">@Model.TotalAmount.ToString("N0") ₫</strong>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="copyRawAmount('@((long)Model.TotalAmount)', this)">
                                            <i class="bi bi-clipboard"></i> Sao chép số tiền
                                        </button>
                                    </div>

                                    <!-- Nội dung chuyển khoản -->
                                    <div class="col-sm-4 text-muted">Nội dung chuyển khoản:</div>
                                    <div class="col-sm-8 d-flex align-items-center justify-content-between bg-light p-2 rounded">
                                        <strong class="text-danger font-monospace fs-6 fw-bold" id="copy-content">@paymentContent</strong>
                                        <button type="button" class="btn btn-sm btn-danger py-0 px-2" onclick="copyText('copy-content', this)">
                                            <i class="bi bi-clipboard"></i> Sao chép nội dung
                                        </button>
                                    </div>
                                </div>

                                <div class="mt-2 text-danger small fst-italic">
                                    * Lưu ý quan trọng: Vui lòng ghi chính xác nội dung chuyển khoản để hệ thống tự động gạch nợ đơn hàng cho bạn nhanh chóng nhất.
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- THÔNG TIN ĐƠN HÀNG & NGƯỜI NHẬN -->
                    <div class="row g-4 mb-4">
                        <!-- Thông tin người nhận -->
                        <div class="col-md-6">
                            <h2 class="h6 fw-bold text-uppercase text-dark mb-3 border-start border-warning border-3 ps-2">
                                👤 Thông tin người nhận
                            </h2>
                            <ul class="list-unstyled small text-muted mb-0 lh-lg">
                                <li>Mã đơn hàng: <strong class="text-dark">@Model.OrderCode</strong></li>
                                <li>Họ và tên: <strong class="text-dark">@Model.CustomerName</strong></li>
                                <li>Số điện thoại: <strong class="text-dark">@Model.CustomerPhone</strong></li>
                                <li>Email: <span class="text-dark">@Model.CustomerEmail</span></li>
                                <li>Địa chỉ nhận hàng: <span class="text-dark">@Model.ShippingAddress</span></li>
                                @if (!string.IsNullOrWhiteSpace(Model.Note))
                                {
                                    <li>Ghi chú: <span class="text-dark fst-italic">@Model.Note</span></li>
                                }
                            </ul>
                        </div>

                        <!-- Trạng thái đơn hàng -->
                        <div class="col-md-6">
                            <h2 class="h6 fw-bold text-uppercase text-dark mb-3 border-start border-warning border-3 ps-2">
                                📋 Tóm tắt đơn hàng
                            </h2>
                            <ul class="list-unstyled small text-muted mb-0 lh-lg">
                                <li>Thời điểm đặt: <strong class="text-dark">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></li>
                                <li>
                                    Trạng thái: 
                                    <span class="badge bg-warning text-dark px-2 py-1">Chờ chuyển khoản VietQR</span>
                                </li>
                                <li>Phương thức: <strong>Chuyển khoản VietQR tự động</strong></li>
                                <li>Phí giao hàng: <strong class="text-success">Miễn phí toàn quốc</strong></li>
                                <li>Tổng thanh toán: <strong class="h5 text-danger fw-bold mb-0">@Model.TotalAmount.ToString("N0") ₫</strong></li>
                            </ul>
                        </div>
                    </div>

                    <!-- DANH SÁCH SẢN PHẨM ĐÃ ĐẶT -->
                    <h2 class="h6 fw-bold text-uppercase text-dark mb-3 border-start border-warning border-3 ps-2">
                        📦 Chi tiết đặc sản đã đặt
                    </h2>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th>Tên đặc sản</th>
                                    <th class="text-center" style="width: 90px;">Số lượng</th>
                                    <th class="text-end" style="width: 130px;">Đơn giá</th>
                                    <th class="text-end" style="width: 140px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 1;
                                }
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="text-center">@(index++)</td>
                                        <td class="fw-semibold">@item.ProductName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                        <td class="text-end fw-bold text-danger">@((item.Quantity * item.UnitPrice).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Nút hành động -->
                    <div class="d-flex flex-wrap gap-2 justify-content-center pt-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-warning fw-bold px-4 py-2 rounded-pill text-dark shadow-sm">
                            🏮 Tiếp tục mua sắm đặc sản Huế
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    function copyText(elementId, btn) {
        var el = document.getElementById(elementId);
        if (!el) return;
        var text = el.innerText || el.textContent;
        navigator.clipboard.writeText(text.trim()).then(function() {
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Đã chép!';
            setTimeout(function() {
                btn.innerHTML = originalHtml;
            }, 2000);
        });
    }

    function copyRawAmount(amount, btn) {
        navigator.clipboard.writeText(amount.toString()).then(function() {
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Đã chép!';
            setTimeout(function() {
                btn.innerHTML = originalHtml;
            }, 2000);
        });
    }
</script>
}
