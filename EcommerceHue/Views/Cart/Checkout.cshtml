@model EcommerceHue.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Đặt hàng & Thanh toán";
}

<!-- ============================================================
     TIÊU ĐỀ TRANG CHECKOUT
     ============================================================ -->
<div class="hue-checkout-header d-flex align-items-center gap-3 mb-4">
    <div class="hue-checkout-icon-wrap">
        <span class="hue-checkout-icon">📋</span>
    </div>
    <div>
        <h1 class="h3 fw-bold mb-0">Đặt hàng & Thanh toán</h1>
        <p class="text-muted small mb-0">Kiểm tra thông tin và xác nhận đơn hàng</p>
    </div>
</div>

<!-- Thông báo -->
@if (TempData["CheckoutError"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-controller="Cart" asp-action="PlaceOrder" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">

        <!-- ============================================================
             CỘT TRÁI: THÔNG TIN GIAO HÀNG
             ============================================================ -->
        <div class="col-lg-7">
            <div class="hue-checkout-card rounded-4 shadow-sm p-4">
                <h2 class="h5 fw-bold mb-4 pb-2 border-bottom">
                    <span class="me-2">📦</span>Thông tin giao hàng
                </h2>

                <!-- Thông báo tự động điền -->
                <div class="alert alert-info border-0 rounded-3 py-2 px-3 mb-4 small">
                    💡 Thông tin đã được điền sẵn từ tài khoản của bạn. Bạn có thể sửa nếu cần.
                </div>

                <!-- Hiển thị lỗi validation -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0"></div>

                <!-- Họ tên -->
                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text hue-input-icon">👤</span>
                        <input asp-for="CustomerName" class="form-control hue-input" />
                    </div>
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <!-- Email + SĐT -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerEmail" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text hue-input-icon">📧</span>
                            <input asp-for="CustomerEmail" class="form-control hue-input" />
                        </div>
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerPhone" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text hue-input-icon">📱</span>
                            <input asp-for="CustomerPhone" class="form-control hue-input" />
                        </div>
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Địa chỉ -->
                <div class="mb-3">
                    <label asp-for="ShippingAddress" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text hue-input-icon">🏠</span>
                        <input asp-for="ShippingAddress" class="form-control hue-input" />
                    </div>
                    <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                </div>

                <!-- Ghi chú -->
                <div class="mb-0">
                    <label asp-for="Note" class="form-label fw-semibold"></label>
                    <textarea asp-for="Note"
                              class="form-control hue-input"
                              rows="3"
                              placeholder="Ví dụ: Giao buổi sáng, gọi trước khi giao..."></textarea>
                </div>
            </div>
        </div>

        <!-- ============================================================
             CỘT PHẢI: TÓM TẮT ĐƠN HÀNG
             ============================================================ -->
        <div class="col-lg-5">
            <div class="hue-checkout-summary rounded-4 shadow-sm p-4 sticky-top" style="top: 1.5rem;">

                <h2 class="h5 fw-bold mb-4 pb-2 border-bottom">🛒 Đơn hàng của bạn</h2>

                <!-- Danh sách sản phẩm -->
                @foreach (var item in Model.CartItems)
                {
                    <div class="hue-checkout-item d-flex gap-3 mb-3 pb-3 border-bottom">
                        <div class="hue-checkout-thumb-wrap flex-shrink-0">
                            <img src="@(item.ImageUrl ?? "/images/placeholder.jpg")"
                                 alt="@item.ProductName"
                                 class="hue-checkout-thumb rounded-3"
                                 onerror="this.src='/images/placeholder.jpg'" />
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@item.ProductName</div>
                            <div class="text-muted small">SL: @item.Quantity × @item.Price.ToString("N0") ₫</div>
                        </div>
                        <div class="fw-bold text-danger small text-nowrap">
                            @item.Total.ToString("N0") ₫
                        </div>
                    </div>
                }

                <!-- Tổng tiền -->
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Tạm tính</span>
                    <span>@Model.SubTotal.ToString("N0") ₫</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span class="text-success fw-semibold">Miễn phí</span>
                </div>

                <hr class="my-3" />

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold fs-6">Tổng thanh toán</span>
                    <span class="fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                </div>

                <!-- Nút đặt hàng -->
                <button type="submit" class="btn hue-btn-place-order w-100 fw-bold rounded-pill py-3 mb-3">
                    💳 Xác nhận đặt hàng & Thanh toán VnPay
                </button>

                <a asp-controller="Cart" asp-action="Index"
                   class="btn btn-outline-secondary w-100 rounded-pill">
                    ← Quay lại giỏ hàng
                </a>

                <div class="hue-secure-badge mt-4 text-center">
                    <span class="text-muted small">🔒 Thanh toán bảo mật qua VnPay · SSL 256-bit</span>
                </div>
            </div>
        </div>

    </div>
</form>

<!-- ============================================================
     STYLES
     ============================================================ -->
@section Styles {
<style>
    .hue-checkout-header { padding: .75rem 0; }
    .hue-checkout-icon-wrap {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, #e8f4fd, #b3d9f7);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 12px rgba(0,109,204,.2);
    }
    .hue-checkout-icon { font-size: 1.6rem; }

    .hue-checkout-card,
    .hue-checkout-summary {
        background: #fff;
        border: 1px solid #f0e6d8;
    }

    .hue-input-icon {
        background: #faf5f0;
        border-color: #e8d5c4;
        font-size: .9rem;
    }
    .hue-input {
        border-color: #e8d5c4;
        transition: border-color .2s, box-shadow .2s;
    }
    .hue-input:focus {
        border-color: #b5451b;
        box-shadow: 0 0 0 .2rem rgba(181,69,27,.15);
    }

    .hue-checkout-thumb-wrap { width: 50px; height: 50px; overflow: hidden; border-radius: 8px; }
    .hue-checkout-thumb { width: 100%; height: 100%; object-fit: cover; }

    .hue-btn-place-order {
        background: linear-gradient(135deg, #006dcc 0%, #0050a3 100%);
        color: #fff;
        border: none;
        letter-spacing: .3px;
        box-shadow: 0 6px 20px rgba(0,109,204,.35);
        transition: transform .15s, box-shadow .15s;
        font-size: 1rem;
    }
    .hue-btn-place-order:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,109,204,.45);
    }
    .hue-btn-place-order:active { transform: translateY(0); }

    .hue-secure-badge {
        border-top: 1px dashed #e8d5c4;
        padding-top: .75rem;
    }
</style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
