@{
    ViewData["Title"] = "Chính sách đổi trả & hoàn tiền đặc sản Huế";
    ViewData["Description"] = "Quy định chi tiết về chính sách đổi trả hàng và hoàn tiền đối với các mặt hàng thực phẩm đặc sản Huế.";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 rounded-pill bg-light border small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active text-dark" aria-current="page">Chính sách đổi trả</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <article class="col-lg-9 col-md-11">
            <header class="text-center mb-5">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 mb-2">
                    🔄 Đảm bảo quyền lợi khách hàng
                </span>
                <h1 class="display-6 fw-bold text-dark mb-3">Chính Sách Đổi Trả & Hoàn Tiền</h1>
                <p class="text-muted lead fs-6 mx-auto" style="max-width: 650px;">
                    Vì đặc thù các sản phẩm là thực phẩm truyền thống, chúng tôi áp dụng chính sách đổi trả minh bạch nhằm mang lại sự an tâm cao nhất cho quý khách.
                </p>
            </header>

            <div class="card rounded-4 border shadow-sm p-4 p-md-5 mb-5 bg-white">
                
                <!-- MỤC 1 -->
                <section class="mb-4 pb-3 border-bottom">
                    <h2 class="h5 fw-bold text-dark mb-3">1. Các trường hợp được đổi trả hoặc hoàn tiền 100%</h2>
                    <p class="text-muted small">
                        Quý khách sẽ được đổi sản phẩm mới hoặc hoàn lại 100% giá trị đơn hàng trong các trường hợp sau:
                    </p>
                    <ul class="text-muted small ps-3">
                        <li class="mb-2"><strong>Sản phẩm bị lỗi đóng gói hoặc hư hỏng do vận chuyển:</strong> Hũ tôm chua bị vỡ, rò rỉ nước, gói mè xửng bị rách túi hút chân không làm kẹo bị chảy nước hoặc ẩm mốc.</li>
                        <li class="mb-2"><strong>Giao sai sản phẩm hoặc thiếu số lượng:</strong> Giao không đúng món đặc sản quý khách đã đặt trong đơn hàng.</li>
                        <li class="mb-2"><strong>Hạn sử dụng không đảm bảo:</strong> Sản phẩm giao đến tay khách hàng còn hạn sử dụng dưới 7 ngày đối với hàng tươi hoặc đã quá hạn sử dụng ghi trên bao bì.</li>
                        <li class="mb-0"><strong>Chất lượng không đúng mô tả:</strong> Sản phẩm có mùi lạ, biến chất khác thường so với tiêu chuẩn đặc sản Huế truyền thống.</li>
                    </ul>
                </section>

                <!-- MỤC 2 -->
                <section class="mb-4 pb-3 border-bottom">
                    <h2 class="h5 fw-bold text-dark mb-3">2. Thời gian tiếp nhận khiếu nại và đổi trả</h2>
                    <ul class="text-muted small ps-3 mb-0">
                        <li class="mb-2"><strong>Đối với thực phẩm lên men tươi (Tôm chua, Tré Huế, Nem chua):</strong> Quý khách vui lòng thông báo trong vòng <strong>24 giờ</strong> kể từ thời điểm nhận hàng từ shipper.</li>
                        <li class="mb-2"><strong>Đối với đồ khô, bánh kẹo và trà (Mè xửng, Trà cung đình, Hạt sen khô):</strong> Thời gian tiếp nhận đổi trả là trong vòng <strong>48 giờ</strong> kể từ khi nhận hàng.</li>
                    </ul>
                </section>

                <!-- MỤC 3 -->
                <section class="mb-4 pb-3 border-bottom">
                    <h2 class="h5 fw-bold text-dark mb-3">3. Quy trình thực hiện đổi trả</h2>
                    <ol class="text-muted small ps-3 mb-0">
                        <li class="mb-2">
                            <strong>Bước 1 - Ghi nhận hình ảnh:</strong> Quý khách chụp ảnh hoặc quay video ngắn tình trạng kiện hàng và sản phẩm bị lỗi.
                        </li>
                        <li class="mb-2">
                            <strong>Bước 2 - Liên hệ hỗ trợ:</strong> Gửi hình ảnh và Mã đơn hàng qua Hotline/Zalo: <strong>0901 234 567</strong> hoặc Email: <a href="mailto:lienhe@dacsanhue.com" class="text-decoration-none">lienhe@dacsanhue.com</a>.
                        </li>
                        <li class="mb-2">
                            <strong>Bước 3 - Xác nhận & Xử lý:</strong> Bộ phận CSKH sẽ xác minh thông tin trong vòng tối đa 2 giờ làm việc.
                        </li>
                        <li class="mb-0">
                            <strong>Bước 4 - Gửi hàng bù hoặc hoàn tiền:</strong> Cửa hàng gửi sản phẩm mới hỏa tốc hoặc chuyển khoản hoàn tiền 100% trong vòng 24 giờ.
                        </li>
                    </ol>
                </section>

                <!-- MỤC 4 -->
                <section>
                    <h2 class="h5 fw-bold text-dark mb-3">4. Chi phí phát sinh trong quá trình đổi trả</h2>
                    <p class="text-muted small mb-0">
                        Mọi chi phí vận chuyển phát sinh khi đổi trả hàng lỗi thuộc về trách nhiệm của Đặc sản Xứ Huế. Quý khách <strong>hoàn toàn không phải chi trả bất kỳ khoản phí nào</strong>.
                    </p>
                </section>

            </div>

            <div class="text-center">
                <a href="tel:0901234567" class="btn btn-warning rounded-pill px-5 py-3 fw-bold shadow-sm text-dark">
                    📞 Gọi tổng đài khiếu nại: 0901 234 567
                </a>
            </div>
        </article>
    </div>
</div>
