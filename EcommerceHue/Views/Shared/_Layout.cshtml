<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-settable=no, user-scalable=no" />
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"] - Đặc sản Huế</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceHue.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark hue-navbar border-bottom shadow-sm mb-4">
            <div class="container">
                <!-- Logo / Brand -->
                <a class="navbar-brand fw-bold hue-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    🏮 Đặc sản Huế
                </a>

                <!-- Toggle button (mobile) -->
                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNavbarCollapse"
                        aria-controls="mainNavbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav links -->
                <div class="collapse navbar-collapse" id="mainNavbarCollapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">🏠 Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-area="" asp-controller="Blog" asp-action="Index">📖 CẨM NANG / TIN TỨC</a>
                        </li>
                    </ul>

                    <!-- Icon giỏ hàng bên phải navbar -->
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link hue-cart-nav d-flex align-items-center gap-2"
                               asp-controller="Cart" asp-action="Index"
                               id="nav-cart-link">
                                🛒 <span>Giỏ hàng</span>
                                <!-- Badge số lượng sản phẩm trong giỏ (JS cập nhật động) -->
                                <span id="cart-badge"
                                      class="badge rounded-pill hue-cart-badge d-none"
                                      aria-label="Số lượng sản phẩm trong giỏ">0</span>
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- User đã đăng nhập: hiện tên + menu dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hue-user-nav d-flex align-items-center gap-2"
                                   href="#" role="button" data-bs-toggle="dropdown"
                                   aria-expanded="false" id="nav-user-menu">
                                    👤 <span class="hue-username">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end hue-dropdown shadow-sm border-0">
                                    <li>
                                        <span class="dropdown-item-text small text-muted">
                                            Xin chào, <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</strong>
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider m-1" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Cart" asp-action="Checkout">
                                            🛒 Tiếp tục thanh toán
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item fw-semibold text-primary" href="/Admin/Orders">
                                                📋 Quản lý đơn hàng (Admin)
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item fw-semibold text-success" href="/Admin/Products">
                                                📦 Quản lý sản phẩm & Tồn kho
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Shipper"))
                                    {
                                        <li>
                                            <a class="dropdown-item fw-semibold text-warning-emphasis" href="/Shipper/Scan" target="_blank">
                                                🛵 App Shipper Quét Mã
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider m-1" /></li>
                                    <li>
                                        <!-- Đăng xuất dùng POST để bảo vệ CSRF -->
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger fw-semibold"
                                                    id="btn-logout">
                                                🚪 Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- User chưa đăng nhập: hiện nút Đăng ký + Đăng nhập -->
                            <li class="nav-item">
                                <a class="nav-link hue-auth-link"
                                   asp-controller="Account" asp-action="Register"
                                   id="nav-register-link">
                                    📝 Đăng ký
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link hue-auth-btn-login"
                                   asp-controller="Account" asp-action="Login"
                                   id="nav-login-link">
                                    🔑 Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ================================================================
         HỆ THỐNG FOOTER CHUYÊN NGHIỆP – 4 CỘT CHUẨN DACSANHUE.INFO
         ================================================================ -->
    <footer class="hue-main-footer border-top mt-5 pt-5 text-dark">
        <div class="container pb-4">
            <div class="row g-4">
                
                <!-- CỘT 1: GIỚI THIỆU THƯƠNG HIỆU -->
                <div class="col-lg-3 col-md-6">
                    <div class="hue-footer-brand d-flex align-items-center gap-2 mb-3">
                        <span class="fs-3">🏮</span>
                        <h4 class="h5 fw-bold text-dark mb-0 text-uppercase tracking-wider">Đặc Sản Xứ Huế</h4>
                    </div>
                    <p class="text-muted small leading-relaxed mb-3">
                        Sứ mệnh gìn giữ và mang trọn hương vị ẩm thực cung đình, các món quà đặc sản Huế chính gốc (mè xửng, tôm chua, trà cung đình, tré...) tươi ngon, chuẩn vị truyền thống đến mọi miền đất nước.
                    </p>
                    <div class="d-flex align-items-center gap-2 text-warning small fw-semibold">
                        <span>⭐ Chuẩn vị truyền thống</span>
                        <span>•</span>
                        <span>100% An toàn</span>
                    </div>
                </div>

                <!-- CỘT 2: HƯỚNG DẪN & CHÍNH SÁCH -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="h6 fw-bold text-dark text-uppercase mb-3 border-start border-warning border-3 ps-2">
                        Hướng Dẫn & Chính Sách
                    </h5>
                    <ul class="list-unstyled hue-footer-links small mb-0">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="HuongDanDatHang" class="text-muted text-decoration-none">📖 Hướng dẫn đặt hàng trực tuyến</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="HuongDanThanhToan" class="text-muted text-decoration-none">💳 Hướng dẫn thanh toán (Chuyển khoản VietQR & COD)</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="ChinhSachBaoMat" class="text-muted text-decoration-none">🔒 Chính sách bảo mật thông tin</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="ChinhSachDoiTra" class="text-muted text-decoration-none">🔄 Chính sách đổi trả & hoàn tiền</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Blog" asp-action="Index" class="text-muted text-decoration-none">📰 Cẩm nang ẩm thực & văn hóa cố đô</a>
                        </li>
                    </ul>
                </div>

                <!-- CỘT 3: THÔNG TIN LIÊN HỆ -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="h6 fw-bold text-dark text-uppercase mb-3 border-start border-warning border-3 ps-2">
                        Thông Tin Liên Hệ
                    </h5>
                    <ul class="list-unstyled hue-footer-contact small mb-0">
                        <li class="mb-2 d-flex align-items-start gap-2">
                            <span class="text-warning">📍</span>
                            <span class="text-muted">Cổng chính Chợ Đông Ba, Đường Trần Hưng Đạo, TP. Huế</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <span class="text-warning">📞</span>
                            <span class="text-muted">Hotline: <strong class="text-dark">0901 234 567</strong> (07:00 - 21:00)</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <span class="text-warning">✉️</span>
                            <span class="text-muted">Email: <a href="mailto:lienhe@dacsanhue.com" class="text-muted text-decoration-none">lienhe@dacsanhue.com</a></span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <span class="text-warning">🚚</span>
                            <span class="text-muted">Giao hàng toàn quốc - Đóng gói cẩn thận</span>
                        </li>
                    </ul>
                </div>

                <!-- CỘT 4: ĐĂNG KÝ NHẬN BẢN TIN (NEWSLETTER) -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="h6 fw-bold text-dark text-uppercase mb-3 border-start border-warning border-3 ps-2">
                        Đăng Ký Nhận Bản Tin
                    </h5>
                    <p class="text-muted small mb-3">
                        Đăng ký ngay để nhận ưu đãi <strong>giảm 10%</strong> cho đơn hàng đầu tiên và tin tức ẩm thực Huế mới nhất.
                    </p>
                    <form id="newsletterForm" class="hue-newsletter-form mb-2" onsubmit="return false;">
                        <div class="input-group mb-2">
                            <input type="email"
                                   id="newsletterEmail"
                                   name="email"
                                   class="form-control hue-newsletter-input"
                                   placeholder="Nhập email của bạn..."
                                   aria-label="Địa chỉ email nhận bản tin"
                                   required />
                            <button type="button"
                                    id="btn-newsletter"
                                    class="btn btn-warning fw-bold px-3 hue-btn-newsletter text-dark">
                                Đăng ký
                            </button>
                        </div>
                    </form>
                    <div class="small text-muted" style="font-size: 0.75rem;">
                        🔒 Cam kết bảo mật, không gửi thư rác.
                    </div>
                </div>

            </div>
        </div>

        <!-- DẢI BẢN QUYỀN VÀ PHƯƠNG THỨC THANH TOÁN -->
        <div class="hue-footer-bottom py-3 border-top bg-light">
            <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2 small text-muted">
                <div>
                    &copy; 2026 <strong>Đặc Sản Xứ Huế</strong> · Giữ trọn tinh hoa văn hóa ẩm thực Cố Đô.
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-semibold">Thanh toán an toàn:</span>
                    <span class="badge bg-white text-primary border shadow-xs px-2 py-1">payOS</span>
                    <span class="badge bg-white text-info border shadow-xs px-2 py-1">Chuyển khoản VietQR</span>
                    <span class="badge bg-white text-success border shadow-xs px-2 py-1">BIDV</span>
                    <span class="badge bg-white text-secondary border shadow-xs px-2 py-1">COD</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ================================================================
         TOAST CONTAINER – hiển thị thông báo góc dưới phải toàn trang
         ================================================================ -->
    <div id="hue-toast-container"
         class="toast-container position-fixed end-0 p-3"
         style="z-index: 1080; bottom: 90px;"
         aria-live="polite"
         aria-atomic="true">
    </div>

    <!-- ================================================================
         KHỐI BONG BÓNG LIÊN HỆ ĐA KÊNH (MULTI-CHANNEL CHAT BUBBLES)
         ================================================================ -->
    <div id="hue-multi-chat-container" class="hue-multi-chat-container" aria-label="Kênh hỗ trợ trực tuyến">
        
        <!-- Nút 1: Zalo Chat Cá Nhân -->
        <a href="https://zalo.me/0912738062"
           target="_blank"
           rel="noopener noreferrer"
           class="zalo-chat-button hue-chat-bubble hue-bubble-zalo"
           title="Chat tư vấn qua Zalo (0912 738 062)"
           aria-label="Liên hệ tư vấn qua Zalo">
            <svg class="hue-bubble-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="24" fill="#0068FF"/>
                <path d="M13 18C13 14.6863 15.6863 12 19 12H29C32.3137 12 35 14.6863 35 18V26C35 29.3137 32.3137 32 29 32H24.5L19 36V32H19C15.6863 32 13 29.3137 13 26V18Z" fill="white"/>
                <path d="M17 19.5H23L18.5 25.5H24V27.5H17V25.5L21.5 19.5H17V19.5Z" fill="#0068FF"/>
                <circle cx="27" cy="23.5" r="1.5" fill="#0068FF"/>
                <circle cx="31.5" cy="23.5" r="1.5" fill="#0068FF"/>
            </svg>
            <span class="hue-bubble-tooltip">Chat Zalo: 0912 738 062</span>
        </a>

        <!-- Nút 2: Facebook Messenger / Chatbot Giả Lập Thông Minh -->
        <button type="button"
                id="btn-toggle-chatbot"
                class="hue-chat-bubble hue-bubble-messenger"
                title="Tư vấn trực tuyến 24/7"
                aria-label="Mở khung trò chuyện hỗ trợ">
            <!-- Icon Messenger SVG -->
            <svg class="hue-bubble-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 2C7.37 2 2 7.04 2 13.25C2 16.8 3.73 19.95 6.44 21.98V26L10.3 23.88C11.47 24.28 12.71 24.5 14 24.5C20.63 24.5 26 19.46 26 13.25C26 7.04 20.63 2 14 2ZM15.4 17.2L12.35 13.95L6.4 17.2L12.95 10.25L16.05 13.5L21.95 10.25L15.4 17.2Z" fill="white"/>
            </svg>
            <!-- Chấm báo online xanh -->
            <span class="hue-bubble-badge-online" title="Đang trực tuyến"></span>
            <span class="hue-bubble-tooltip">Tư vấn 24/7</span>
        </button>

    </div>

    <!-- ================================================================
         CỬA SỔ CHATBOT GIẢ LẬP THÔNG MINH (INTERACTIVE CHATBOT WINDOW)
         ================================================================ -->
    <div id="hue-chatbot-window" class="hue-chatbot-window chatbot-window d-none" aria-hidden="true">
        
        <!-- Header Chatbot -->
        <div class="hue-chatbot-header">
            <div class="d-flex align-items-center gap-2">
                <div class="position-relative">
                    <div class="hue-bot-avatar">🏮</div>
                    <span class="hue-bot-status-dot" title="Đang trực tuyến"></span>
                </div>
                <div>
                    <div class="hue-bot-title">Trợ Lý Ẩm Thực Cố Đô</div>
                    <div class="hue-bot-status-text">● Trực tuyến · Phản hồi tức thì</div>
                </div>
            </div>
            <button type="button" id="btn-close-chatbot" class="hue-btn-chat-close" title="Đóng cửa sổ chat" aria-label="Đóng">
                ✕
            </button>
        </div>

        <!-- Body Chatbot (Khu vực tin nhắn) -->
        <div id="hue-chatbot-body" class="hue-chatbot-body">
            <!-- Tin nhắn chào mừng ban đầu -->
            <div class="hue-msg hue-msg-bot">
                <div class="hue-msg-bubble">
                    Xin chào! Đặc sản xứ Huế - <strong>EcommerceHue</strong> có thể giúp gì cho bạn? 🏮
                </div>
                <div class="hue-msg-time">Vừa xong</div>
            </div>

            <!-- 3 Nút gợi ý câu hỏi nhanh -->
            <div id="hue-quick-questions" class="hue-quick-questions my-2">
                <div class="hue-quick-title text-muted mb-2 small fw-semibold">💡 Gợi ý câu hỏi nhanh:</div>
                <button type="button" class="hue-btn-quick" data-question="1">
                    🚚 Phí vận chuyển và thời gian giao đặc sản Huế là bao lâu?
                </button>
                <button type="button" class="hue-btn-quick" data-question="2">
                    💳 Cách thức thanh toán đơn hàng như thế nào?
                </button>
                <button type="button" class="hue-btn-quick" data-question="3">
                    🎁 Mã giảm giá đơn hàng đầu tiên lấy ở đâu?
                </button>
            </div>
        </div>

        <!-- Footer Chatbot (Ô nhập liệu câu hỏi) -->
        <div class="hue-chatbot-footer">
            <form id="hue-chatbot-form" class="d-flex align-items-center gap-2 m-0" onsubmit="return false;">
                <input type="text"
                       id="hue-chatbot-input"
                       class="form-control hue-chat-input"
                       placeholder="Nhập câu hỏi của bạn..."
                       autocomplete="off" />
                <button type="submit" id="btn-send-chat" class="btn btn-warning hue-btn-send" title="Gửi tin nhắn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <script>
    // ====================================================================
    // HUE CART GLOBAL HELPERS
    // Khai báo toàn cục để mọi View đều gọi được.
    // ====================================================================

    /**
     * Hiển thị Toast thông báo góc dưới phải màn hình.
     * @@param {string} message  - Nội dung thông báo
     * @@param {'success'|'warning'|'error'} type - Loại thông báo
     */
    function showToast(message, type = 'success') {
        const icons = { success: '✅', warning: '⚠️', error: '❌' };
        const colors = {
            success : 'linear-gradient(135deg,#2d6a4f,#52b788)',
            warning : 'linear-gradient(135deg,#b5451b,#e8722a)',
            error   : 'linear-gradient(135deg,#7b2d00,#c0392b)'
        };

        const toastId = 'toast-' + Date.now();
        const html = `
            <div id="${toastId}" class="toast hue-toast align-items-center border-0 show"
                 role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-center gap-3 p-3" style="background:${colors[type]};border-radius:12px;">
                    <span class="fs-5">${icons[type]}</span>
                    <span class="text-white fw-semibold flex-grow-1 small">${message}</span>
                    <button type="button" class="btn-close btn-close-white flex-shrink-0"
                            onclick="document.getElementById('${toastId}').remove()"
                            aria-label="Đóng"></button>
                </div>
            </div>`;

        const container = document.getElementById('hue-toast-container');
        container.insertAdjacentHTML('beforeend', html);

        // Tự xóa sau 3.5 giây
        setTimeout(() => {
            const el = document.getElementById(toastId);
            if (el) {
                el.style.transition = 'opacity .4s';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 420);
            }
        }, 3500);
    }

    /**
     * Lấy số lượng sản phẩm trong giỏ từ API và cập nhật badge trên navbar.
     */
    function fetchCartCount() {
        fetch('/Cart/GetCartCount')
            .then(r => r.json())
            .then(data => {
                // Đón nhận cả giá trị số 0 trực tiếp hoặc object { count: 0 }
                const count = (typeof data === 'object' && data !== null) ? (data.count ?? 0) : (Number(data) || 0);
                updateCartBadge(count);
            })
            .catch(() => updateCartBadge(0)); // Lỗi mạng hoặc session – hiển thị 0 an toàn
    }

    /**
     * Cập nhật badge giỏ hàng trên navbar.
     * @@param {number} count - Tổng số lượng sản phẩm trong giỏ
     */
    function updateCartBadge(count) {
        const badge = document.getElementById('cart-badge');
        if (!badge) return;
        if (count > 0) {
            badge.textContent = count > 99 ? '99+' : count;
            badge.classList.remove('d-none');

            // Hiệu ứng bật nẩy nhỏ khi số thay đổi
            badge.classList.add('hue-badge-bump');
            setTimeout(() => badge.classList.remove('hue-badge-bump'), 350);
        } else {
            badge.classList.add('d-none');
        }
    }

    // Khởi tạo: load số lượng giỏ hàng ngay khi trang được load
    document.addEventListener('DOMContentLoaded', fetchCartCount);

    // ====================================================================
    // NEWSLETTER AJAX FETCH API – Bắt sự kiện click nút 'Đăng ký'
    // ====================================================================
    document.addEventListener('DOMContentLoaded', function () {
        const btnNewsletter = document.getElementById('btn-newsletter');
        const emailInput = document.getElementById('newsletterEmail') || document.getElementById('newsletter-email');

        async function handleNewsletterSubmit() {
            if (!emailInput) return;
            const email = emailInput.value.trim();

            if (!email) {
                showToast('Vui lòng nhập địa chỉ email của bạn.', 'warning');
                emailInput.focus();
                return;
            }

            // Hiệu ứng loading trên nút bấm
            const originalHtml = btnNewsletter ? btnNewsletter.innerHTML : 'Đăng ký';
            if (btnNewsletter) {
                btnNewsletter.disabled = true;
                btnNewsletter.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang gửi...';
            }

            try {
                // Gửi dữ liệu qua fetch API đến Action SubscribeNewsletter
                const formData = new URLSearchParams();
                formData.append('email', email);

                const response = await fetch('/Account/SubscribeNewsletter', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData.toString()
                });

                if (!response.ok) {
                    throw new Error(`Mã lỗi HTTP: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    // Hiển thị thông báo Toast mượt mà và làm trống ô nhập
                    showToast(result.message, 'success');
                    emailInput.value = '';
                } else {
                    showToast(result.message, 'warning');
                }
            } catch (err) {
                console.error('[Newsletter AJAX] Lỗi:', err);
                showToast('Có lỗi xảy ra khi gửi đăng ký. Vui lòng thử lại sau!', 'error');
            } finally {
                if (btnNewsletter) {
                    btnNewsletter.disabled = false;
                    btnNewsletter.innerHTML = originalHtml;
                }
            }
        }

        // Bắt sự kiện click vào nút Đăng ký
        if (btnNewsletter) {
            btnNewsletter.addEventListener('click', handleNewsletterSubmit);
        }

        // Hỗ trợ người dùng nhấn phím Enter ngay trong ô nhập email
        if (emailInput) {
            emailInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleNewsletterSubmit();
                }
            });
        }
    });

    // ====================================================================
    // MULTI-CHANNEL CHAT & INTELLIGENT CHATBOT CONTROLLER
    // ====================================================================
    document.addEventListener('DOMContentLoaded', function () {
        const btnToggleChat = document.getElementById('btn-toggle-chatbot');
        const btnCloseChat = document.getElementById('btn-close-chatbot');
        const chatWindow = document.getElementById('hue-chatbot-window');
        const chatBody = document.getElementById('hue-chatbot-body');
        const chatInput = document.getElementById('hue-chatbot-input');
        const chatForm = document.getElementById('hue-chatbot-form');
        const quickQuestions = document.querySelectorAll('.hue-btn-quick');

        // Các kịch bản trả lời tự động chuẩn theo yêu cầu
        const botAnswers = {
            1: 'Hệ thống áp dụng chính sách giao nhận 2 cấp mới sáp nhập. Thời gian giao nội thành Huế là 24h, các tỉnh thành khác từ 2-3 ngày ạ! 🚚',
            2: 'Shop hỗ trợ chuyển khoản VietQR gạch nợ tự động qua BIDV và ship COD nhận hàng trả tiền nhé! 💳',
            3: 'Bạn chỉ cần nhập Email vào ô Đăng ký nhận bản tin ở chân trang, hệ thống sẽ tự động gửi mã HUEDACSAN10 giảm 10% vào Gmail của bạn ngay lập tức! 🎁'
        };

        // Bật / Tắt cửa sổ Chat
        function toggleChatbot() {
            if (!chatWindow) return;
            const isHidden = chatWindow.classList.contains('d-none');
            if (isHidden) {
                chatWindow.classList.remove('d-none');
                chatWindow.setAttribute('aria-hidden', 'false');
                if (chatInput) chatInput.focus();
                scrollToBottom();
            } else {
                chatWindow.classList.add('d-none');
                chatWindow.setAttribute('aria-hidden', 'true');
            }
        }

        if (btnToggleChat) btnToggleChat.addEventListener('click', toggleChatbot);
        if (btnCloseChat) {
            btnCloseChat.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (chatWindow) {
                    chatWindow.classList.add('d-none');
                    chatWindow.setAttribute('aria-hidden', 'true');
                }
            });
        }

        // Cuộn xuống tin nhắn mới nhất
        function scrollToBottom() {
            if (chatBody) {
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        }

        // Thêm tin nhắn của Khách hàng
        function appendUserMessage(text) {
            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const msgHtml = `
                <div class="hue-msg hue-msg-user">
                    <div class="hue-msg-bubble">${escapeHtml(text)}</div>
                    <div class="hue-msg-time text-end">${timeStr}</div>
                </div>
            `;
            chatBody.insertAdjacentHTML('beforeend', msgHtml);
            scrollToBottom();
        }

        // Hiển thị hiệu ứng Bot đang gõ tin nhắn (Typing indicator)
        function showTypingIndicator() {
            const typingHtml = `
                <div id="hue-typing-indicator" class="hue-msg hue-msg-bot">
                    <div class="hue-msg-bubble hue-typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            `;
            chatBody.insertAdjacentHTML('beforeend', typingHtml);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const typing = document.getElementById('hue-typing-indicator');
            if (typing) typing.remove();
        }

        // Thêm tin nhắn trả lời của Bot
        function appendBotMessage(text) {
            removeTypingIndicator();
            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const msgHtml = `
                <div class="hue-msg hue-msg-bot">
                    <div class="hue-msg-bubble">${text}</div>
                    <div class="hue-msg-time">${timeStr}</div>
                </div>
            `;
            chatBody.insertAdjacentHTML('beforeend', msgHtml);
            scrollToBottom();
        }

        // Xử lý khi bấm nút câu hỏi gợi ý nhanh
        quickQuestions.forEach(btn => {
            btn.addEventListener('click', function () {
                const qId = this.getAttribute('data-question');
                const userQuestionText = this.innerText.replace(/^[^\s]+\s/, ''); // Bỏ icon đầu
                appendUserMessage(userQuestionText);

                showTypingIndicator();
                setTimeout(() => {
                    const answer = botAnswers[qId] || 'Dạ, Quý khách vui lòng để lại số điện thoại hoặc liên hệ Hotline 0901 234 567 để được hỗ trợ chu đáo nhất ạ!';
                    appendBotMessage(answer);
                }, 550);
            });
        });

        // Xử lý khi người dùng gõ tin nhắn tự do
        function handleUserSubmit() {
            if (!chatInput) return;
            const text = chatInput.value.trim();
            if (!text) return;

            appendUserMessage(text);
            chatInput.value = '';

            // Phân tích từ khóa thông minh
            showTypingIndicator();
            setTimeout(() => {
                const lower = text.toLowerCase();
                let reply = '';
                if (lower.includes('vận chuyển') || lower.includes('ship') || lower.includes('giao hàng') || lower.includes('bao lâu') || lower.includes('thời gian')) {
                    reply = botAnswers[1];
                } else if (lower.includes('thanh toán') || lower.includes('vietqr') || lower.includes('bidv') || lower.includes('cod') || lower.includes('chuyển khoản')) {
                    reply = botAnswers[2];
                } else if (lower.includes('giảm giá') || lower.includes('mã') || lower.includes('coupon') || lower.includes('voucher') || lower.includes('10%')) {
                    reply = botAnswers[3];
                } else {
                    reply = 'Cảm ơn Quý khách đã gửi tin nhắn! Ngoài các câu hỏi thường gặp, Quý khách có thể gọi Hotline <strong>0901 234 567</strong> hoặc bấm nút Zalo bên cạnh để chuyên viên ẩm thực Huế tư vấn trực tiếp 24/7 ạ! 🏮';
                }
                appendBotMessage(reply);
            }, 550);
        }

        if (chatForm) {
            chatForm.addEventListener('submit', function (e) {
                e.preventDefault();
                handleUserSubmit();
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    });
    </script>

